\u0275text"](86," This step is carried out by making a POST request from the authentication service. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](87,"p"),r["\u0275\u0275elementStart"](88,"em"),r["\u0275\u0275elementStart"](89,"strong"),r["\u0275\u0275text"](90,"POST /connect/token"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](91,"tr",3),r["\u0275\u0275elementStart"](92,"td"),r["\u0275\u0275elementStart"](93,"p"),r["\u0275\u0275elementStart"](94,"strong"),r["\u0275\u0275text"](95,"Step 3: Set up the Payment-Order -"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](96,"p"),r["\u0275\u0275elementStart"](97,"strong"),r["\u0275\u0275text"](98,"Consent"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](99,"td"),r["\u0275\u0275elementStart"](100,"p"),r["\u0275\u0275elementStart"](101,"strong"),r["\u0275\u0275text"](102,"PISP /"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](103,"p"),r["\u0275\u0275elementStart"](104,"strong"),r["\u0275\u0275text"](105,"TPP"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](106,"td"),r["\u0275\u0275elementStart"](107,"p"),r["\u0275\u0275text"](108," The TPP creates a consent request in the consent management system which records the details of the payment and returns a consent ID. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](109,"ul"),r["\u0275\u0275elementStart"](110,"li"),r["\u0275\u0275elementStart"](111,"p"),r["\u0275\u0275text"](112," The PISP connects to Absa as the ASPSP that services the PSU's payment account and creates a new payment-order-consents resource. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](113,"li"),r["\u0275\u0275elementStart"](114,"p"),r["\u0275\u0275text"](115," This informs the ASPSP that one of its PSUs intends to make a payment-order. Absa as the ASPSP responds with the consent ID, which is identifier for the payment-order. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](116,"p"),r["\u0275\u0275text"](117," This step is carried out by making a POST request to the payment-order-consents resource. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](118,"p"),r["\u0275\u0275elementStart"](119,"em"),r["\u0275\u0275elementStart"](120,"strong"),r["\u0275\u0275text"](121,"POST /domestic-payment-consents"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](122,"tr",4),r["\u0275\u0275elementStart"](123,"td"),r["\u0275\u0275elementStart"](124,"strong"),r["\u0275\u0275text"](125,"Step 4: Authorise consent"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](126,"td"),r["\u0275\u0275elementStart"](127,"strong"),r["\u0275\u0275text"](128,"PSU/Absa"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](129,"td"),r["\u0275\u0275elementStart"](130,"p"),r["\u0275\u0275text"](131," The PISP requests the PSU to authorise the consent by redirecting the PSU to an Absa banking channel to log on, view and authorise the consent. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](132,"ul"),r["\u0275\u0275elementStart"](133,"li"),r["\u0275\u0275elementStart"](134,"p"),r["\u0275\u0275text"](135," The redirection includes the consent ID generated in the previous step. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](136,"li"),r["\u0275\u0275elementStart"](137,"p"),r["\u0275\u0275text"](138," This allows Absa as the ASPSP to correlate the payment order consent that was set up. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](139,"li"),r["\u0275\u0275elementStart"](140,"p"),r["\u0275\u0275text"](141,"Absa authenticates the PSU."),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](142,"li"),r["\u0275\u0275elementStart"](143,"p"),r["\u0275\u0275text"](144," Absa updates the state of the payment-order-consents resource internally to indicate that the consent has been authorised. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](145,"li"),r["\u0275\u0275elementStart"](146,"p"),r["\u0275\u0275text"](147," Once the consent has been authorised, the PSU is redirected back to the PISP/TPP. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](148,"li"),r["\u0275\u0275elementStart"](149,"p"),r["\u0275\u0275text"](150," An authorisation code is shared with the PISP that is required to verify funds and finalise payment. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](151,"p"),r["\u0275\u0275text"](152," This step is initiated on the TPP platform and authorised by the PSU on an Absa banking channel using their Absa login credentials. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](153,"p"),r["\u0275\u0275elementStart"](154,"em"),r["\u0275\u0275elementStart"](155,"strong"),r["\u0275\u0275text"](156,"Please refer to section Absa Client Auth SSO in the Developer Guide"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](157,"tr",3),r["\u0275\u0275elementStart"](158,"td"),r["\u0275\u0275elementStart"](159,"strong"),r["\u0275\u0275text"](160,"Step 5: Get Consent Status"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"