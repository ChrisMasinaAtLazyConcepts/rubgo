:0,consts:[[1,"page-content"],["href","https://developer.absa.africa/static/documentation/get-started-oauth-clients"],[1,"screen1"],["src","/assets/images/our-apis/retail-payments/Sso.image2.jpg","alt",""],["src","/assets/images/our-apis/retail-payments/Sso.image3.jpg","alt",""],["href","https://protect-za.mimecast.com/s/eTxuClOL5Gt1r4nn7CGC9xl?domain=Keycloak.org"],["href","https://protect-za.mimecast.com/s/miJmCmw6QJHpx4JJ2uOZnHG?domain=Keycloak.org"],[1,"mark"],["href","https://datatracker.ietf.org/doc/html/rfc7636"],["href","https://protect-za.mimecast.com/s/F4OtCnZXrKhXEBOO5sNTUl2?domain=Keycloak.org"],["href","https://protect-za.mimecast.com/s/jky1CoYKQLiDnWqq4t6cxfO?domain=Keycloak.org"],["href","https://absaauth-uat.absabank.co.ke/auth/realms/sandbox/protocol/OpenID-connect/auth"],["href","https://absaauth-uat.absabank.co.ke/auth/realms/sandbox/protocol/OpenID-connect/token"],["src","/assets/images/our-apis/retail-payments/Sso.image4.jpg","alt",""],["src","/assets/images/our-apis/retail-payments/Sso.image5.jpg","alt",""],["src","/assets/images/our-apis/retail-payments/Sso.image6.jpg","alt",""],[1,"screen2"],["src","/assets/images/our-apis/retail-payments/Sso.image7.png","alt",""],["href","https://absaauthuat.absabank.co.ke/auth/realms/sandbox/protocol/OpenID-connect/auth"],["src","/assets/images/our-apis/retail-payments/Sso.image8.jpg","alt",""],["src","/assets/images/our-apis/retail-payments/Sso.image9.jpg","alt",""],["src","/assets/images/our-apis/retail-payments/Sso.image10.jpg","alt",""],["src","/assets/images/our-apis/retail-payments/Sso.image11.jpg","alt",""],["href","https://www.keycloak.org/docs/latest/securing_apps/#_javascript_adapter"]],template:function(e,t){1&e&&(r["\u0275\u0275elementStart"](0,"div",0),r["\u0275\u0275elementStart"](1,"h1"),r["\u0275\u0275text"](2,"Absa Client OAuth SSO - Developer Guide"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](3,"p"),r["\u0275\u0275text"](4," This guide contains the information and steps required to use the ARO SSO environment for the Open Banking consent part. The guide is for third-party developers (Corporate and FinTech) to integrate with their applications. The content below is intended to be published to the Absa Access API developer portal. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](5,"h2"),r["\u0275\u0275text"](6,"Open Banking Consent - OAuth client"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](7,"h3"),r["\u0275\u0275text"](8,"Introduction"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](9,"p"),r["\u0275\u0275text"](10," In addition to the OAuth Client, documented here "),r["\u0275\u0275elementStart"](11,"a",1),r["\u0275\u0275elementStart"](12,"u"),r["\u0275\u0275text"](13,"Absa Access Developer Portal"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275text"](14,", "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275text"](15," that needs to be created to authenticate access to the "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](16,"p"),r["\u0275\u0275text"](17," Absa APIs, a second and separate OAuth client registration needs to take place. This second OAuth client registration is within the Absa SSO environment and is required to use the Open Banking APIs. The Absa SSO environment provides the authentication and consent application that the Absa customer will use to provide the consent required to use the Open Banking Payment Initiation and Account Information APIs. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](18,"p"),r["\u0275\u0275text"](19," The Open Banking OAuth Consent client uses the OpenID Connect protocol with a redirection flow, known as the authorisation code flow, to allow Absa banking customers to authenticate and provide consent for payment and information requests for their Absa accounts in an Absa-provided environment. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](20,"p"),r["\u0275\u0275text"](21," This is the Absa SSO login page with which customers will be presented after being re-directed to the Absa SSO environment: "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](22,"p"),r["\u0275\u0275text"](23," After successfully logging in, a customer will be presented with a consent page. This is the consent page for a payment initiation request: "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](24,"div",2),r["\u0275\u0275elementStart"](25,"p"),r["\u0275\u0275element"](26,"img",3),r["\u0275\u0275text"](27," Absa SSO login screen "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](28,"p"),r["\u0275\u0275element"](29,"img",4),r["\u0275\u0275text"](30," Absa SSO payment consent screen "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](31,"h3"),r["\u0275\u0275text"](32,"Getting started"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](33,"p"),r["\u0275\u0275text"](34," Before you can configure an Open Banking OAuth Consent client for your web or mobile app, Absa will first need to create and configure your client on the Absa SSO environment. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](35,"p"),r["\u0275\u0275text"](36,"The following information needs to be provided to Absa:"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](37,"p"),r["\u0275\u0275text"](38,"OAuth Client Adapter"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](39,"ul"),r["\u0275\u0275elementStart"](40,"li"),r["\u0275\u0275elementStart"](41,"p"),r["\u0275\u0275text"](42," Absa will need to know which adapter type you will be using. This can be one of the adapters provided by Keycloak, other providers or a custom adapter e.g., Java adapter, Nodejs adapter, etc. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](43,"li"),r["\u0275\u0275elementStart"](44,"p"),r["\u0275\u0275text"](45," This information is required by Absa to ensure that your client is correctly and securely configured on the Absa SSO environment. Absa may request or provide additional information based on the \u201cClient Adapter\u201d that you use. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](46,"ul"),r["\u0275\u0275elementStart"](47,"li"),r["\u0275\u0275elementStart"](48,"p"),r["\u0275\u0275text"](49,"Origin URL"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](50,"ul"),r["\u0275\u0275elementStart"](51,"li"),r["\u0275\u0275elementStart"](52,"p"),r["\u0275\u0275text"](53," This is the URL(s) from which all your application requests to the Absa SSO environment will originate. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](54,"li"),r["\u0275\u0275elementStart"](55,"p"),r["\u0275\u0275text"](56," You may provide multiple URLs and these may differ per environment. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](57,"li"),r["\u0275\u0275elementStart"](58,"p"),r["\u0275\u0275text"](59," Absa will use these URLs to restrict the allowed CORS origins to secure Absa SSO. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](60,"li"),r["\u0275\u0275elementStart"](61,"p"),r["\u0275\u0275text"](62,"Re-direct URI"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](63,"ul"),r["\u0275\u0275elementStart"](64,"li"),r["\u0275\u0275elementStart"](65,"p"),r["\u0275\u0275text"](66," This is the URI (s) of your application callback, to which the Absa SSO must re-direct the customer, after the consent has been completed, whether successful or failed. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](67,"li"),r["\u0275\u0275elementStart"](68,"p"),r["\u0275\u0275text"](69," You may provide multiple URIs and these may differ per environment. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](70,"li"),r["\u0275\u0275elementStart"](71,"p"),r["\u0275\u0275text"](72," These URIs will typically be set up as a callback within your application and have the same hostname as in the origin URL. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](73,"li"),r["\u0275\u0275elementStart"](74,"p"),r["\u0275\u0275text"](75," Absa will place these URIs on an \u201cAllowed\u201d list on Absa SSO for your client adapter. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](76,"li"),r["\u0275\u0275elementStart"](77,"p"),r["\u0275\u0275text"](78," Even though your \u201cClient Adapter\u201d will send a redirect URI with every request, Absa SSO will confirm that the URI is on the \u201cAllowed\u201d list before allowing the request to be received. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](79,"h3"),r["\u0275\u0275text"](80,"Selecting a client adapter"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](81,"p"),r["\u0275\u0275text"](82," You will need to determine which \u201cClient Adapter\u201d will best suit your application and architecture. Keycloak provides several adapters: "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](83,"ul"),r["\u0275\u0275elementStart"](84,"li"),r["\u0275\u0275elementStart"](85,"p"),r["\u0275\u0275text"](86,"Java adapters"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](87,"ul"),r["\u0275\u0275elementStart"](88,"li"),r["\u0275\u0275elementStart"](89,"p"),r["\u0275\u0275text"](90," Keycloak comes with a range of different adapters for Java application. Selecting the correct adapter depends on the target platform. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](91,"li"),r["\u0275\u0275elementStart"](92,"p"),r["\u0275\u0275elementStart"](93,"a",5),r["\u0275\u0275text"](94,"https://www.Keycloak.org/docs/latest/securing_apps/#java-adapters"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](95,"li"),r["\u0275\u0275elementStart"](96,"p"),r["\u0275\u0275text"](97,"JavaScript adapter"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](98,"ul"),r["\u0275\u0275elementStart"](99,"li"),r["\u0275\u0275text"](100," Keycloak comes with a client-side JavaScript library that can be used to secure HTML5/JavaScript applications. The JavaScript adapter has built-in support for Cordova applications. "),r["\u0275\u0275elementStart"](101,"a",6),r["\u0275\u0275text"](102,"https://www.Keycloak.org/docs/latest/securing_apps/#_javascript_adapter"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](103,"p"),r["\u0275\u0275elementStart"](104,"strong"),r["\u0275\u0275elementStart"](105,"span",7),r["\u0275\u0275text"](106,"NB NOTE: It is important to note that when using client-side applications, there is no secure way to store client credentials in a client-side application. Absa will require that you use the Authorization Code with PKCE ( "),r["\u0275\u0275elementStart"](107,"a",8),r["\u0275\u0275text"](108,"Proof Key "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](109,"span",7),r["\u0275\u0275elementStart"](110,"strong"),r["\u0275\u0275elementStart"](111,"em"),r["\u0275\u0275elementStart"](112,"a",8),r["\u0275\u0275text"](113," for Code Exchange"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275text"](114,") flow. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](115,"li"),r["\u0275\u0275elementStart"](116,"p"),r["\u0275\u0275text"](117,"Node.js adapter"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](118,"ul"),r["\u0275\u0275elementStart"](119,"li"),r["\u0275\u0275elementStart"](120,"p"),r["\u0275\u0275text"](121," Keycloak provides a Node.js adapter built on top of Connect to protect server-side JavaScript apps - the goal is to be flexible enough to integrate with frameworks like Express.js. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](122,"li"),r["\u0275\u0275elementStart"](123,"p"),r["\u0275\u0275elementStart"](124,"a",9),r["\u0275\u0275text"](125,"https://www.Keycloak.org/docs/latest/securing_apps/#_nodejs_adapter"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](126,"li"),r["\u0275\u0275elementStart"](127,"p"),r["\u0275\u0275text"](128,"Other OpenID Connect libraries"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](129,"ul"),r["\u0275\u0275elementStart"](130,"li"),r["\u0275\u0275elementStart"](131,"p"),r["\u0275\u0275text"](132," Keycloak can be secured by supplied adapters that are usually easier to use and provide better integration with Keycloak. However, if an adapter is not available for your programming language, framework or platform, you may opt to use a generic OpenID Connect Relying Party (RP) library instead. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](133,"li"),r["\u0275\u0275elementStart"](134,"p"),r["\u0275\u0275elementStart"](135,"a",10),r["\u0275\u0275text"](136,"https://www.Keycloak.org/docs/latest/securing_apps/#other-OpenID-connect-libraries"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](137,"h3"),r["\u0275\u0275text"](138,"Configuring your client adapter"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](139,"p"),r["\u0275\u0275text"](140," Once Absa has completed the client configuration on Absa SSO, you will be provided with the following, which you will need for configuring your client adapter. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](141,"ul"),r["\u0275\u0275elementStart"](142,"li"),r["\u0275\u0275elementStart"](143,"p"),r["\u0275\u0275elementStart"](144,"strong"),r["\u0275\u0275text"](145,"Auth server URL"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](146,"ul"),r["\u0275\u0275elementStart"](147,"li"),r["\u0275\u0275text"](148,"This is the Absa SSO server\u2019s base realm URL."),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](149,"li"),r["\u0275\u0275text"](150,"It is also referred to as the \u201cissuer\u201d or \u201ciss\u201d URL."),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](151,"li"),r["\u0275\u0275text"](152," Your \u201cClient Adapter\u201d will use this URL as the base for all Absa SSO requests. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](153,"li"),r["\u0275\u0275text"](154," You will be provided with a URL per environment, i.e., UAT, Pre-prod and Production. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](155,"li"),r["\u0275\u0275elementStart"](156,"p"),r["\u0275\u0275elementStart"](157,"strong"),r["\u0275\u0275text"](158,"Authentication endpoint URL"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](159,"ul"),r["\u0275\u0275elementStart"](160,"li"),r["\u0275\u0275text"](161,"This is the Absa SSO server\u2019s authentication endpoint URL."),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](162,"li"),r["\u0275\u0275text"](163," Your \u201cClient Adapter\u201d will use this endpoint to request a new authentication by re-directing the Absa customer\u2019s browser to this URL. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](164,"li"),r["\u0275\u0275text"](165," You will be provided with a URL per environment, i.e., UAT, Pre-prod and Production. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](166,"li"),r["\u0275\u0275elementStart"](167,"p"),r["\u0275\u0275elementStart"](168,"strong"),r["\u0275\u0275text"](169,"AccessToken endpoint URL"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](170,"ul"),r["\u0275\u0275elementStart"](171,"li"),r["\u0275\u0275text"](172,"This is the Absa SSO server\u2019s token endpoint URL."),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](173,"li"),r["\u0275\u0275text"](174," Your \u201cClient Adapter\u201d will use this endpoint to exchange the authorisation code it received after a successful authorisation, for an Access and Refresh token. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](175,"li"),r["\u0275\u0275text"](176," You will be provided with a URL per environment, i.e., UAT, Pre-prod and Production. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](177,"li"),r["\u0275\u0275elementStart"](178,"p"),r["\u0275\u0275elementStart"](179,"strong"),r["\u0275\u0275text"](180,"OpenID Connect Well-Known URL"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](181,"ul"),r["\u0275\u0275elementStart"](182,"li"),r["\u0275\u0275text"](183," This the URL where Absa SSO publishes its OpenID Connect metadata, also referred to as the discovery document. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](184,"li"),r["\u0275\u0275text"](185," Your \u201cClient Adapter\u201d may use this URL to retrieve the OpenID Connect values it requires. You will be provided with a URL per environment, i.e., UAT, Pre-prod and Production. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](186,"li"),r["\u0275\u0275elementStart"](187,"p"),r["\u0275\u0275elementStart"](188,"strong"),r["\u0275\u0275text"](189,"ClientID"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](190,"ul"),r["\u0275\u0275elementStart"](191,"li"),r["\u0275\u0275text"](192,"The \u201cClient ID\u201d will be unique to your application."),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](193,"li"),r["\u0275\u0275text"](194," Your \u201cClient Adapter\u201d will use this ID to identify your application on Absa SSO requests. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](195,"li"),r["\u0275\u0275text"](196," You will be provided with a \u201cClient ID\u201d per environment, i.e., UAT, Pre-prod and Production. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](197,"li"),r["\u0275\u0275elementStart"](198,"p"),r["\u0275\u0275elementStart"](199,"strong"),r["\u0275\u0275text"](200,"Client secret"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](201,"ul"),r["\u0275\u0275elementStart"](202,"li"),r["\u0275\u0275text"](203," The \u201cClient Secret\u201d will be paired with the \u201cClient ID\u201d and will be unique to your application. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](204,"li"),r["\u0275\u0275text"](205," Your \u201cClient Adapter\u201d will use the secret with Absa SSO requests. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](206,"li"),r["\u0275\u0275text"](207," You will be provided with a \u201cClient Secret\u201d per environment, i.e., UAT, Pre-prod and Production. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](208,"blockquote"),r["\u0275\u0275elementStart"](209,"p"),r["\u0275\u0275text"](210," NB NOTE: The \u201cClient Secret\u201d will only be applicable and provided if your \u201cClient Adapter\u201d type and architecture meet the requirement for the \u201cConfidential\u201d OpenID Connect flow type. In most cases, Absa will not use this flow type. If there is an exception made then \u2014 to meet this requirement \u2014 your \u201cClient Adapter\u201d must not expose the \u201cClient Secret\u201d to the client-side of your application; it must store and use the \u201cClient Secret\u201d on the server-side of the application. As an example, the Keycloak JavaScript \u201cClient Adapter\u201d does not meet this requirement as all code is client-side. Refer to the Code Challenge Method below. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](211,"ul"),r["\u0275\u0275elementStart"](212,"li"),r["\u0275\u0275elementStart"](213,"p"),r["\u0275\u0275elementStart"](214,"strong"),r["\u0275\u0275text"](215,"Code Challenge Method"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](216,"ul"),r["\u0275\u0275elementStart"](217,"li"),r["\u0275\u0275text"](218," This configuration is applicable if your \u201cClient Adapter\u201d needs to use the Authorisation Code Flow with PKCE. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](219,"li"),r["\u0275\u0275text"](220," This flow must be used when your \u201cClient Adapter\u201d cannot secure the \u201cClient Secret\u201d as stated above. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](221,"li"),r["\u0275\u0275text"](222," The value provided is the PKCE challenge method that your \u201cClient Adapter\u201d will use with Absa SSO, i.e., S256. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](223,"li"),r["\u0275\u0275elementStart"](224,"p"),r["\u0275\u0275elementStart"](225,"strong"),r["\u0275\u0275text"](226,"Scope"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](227,"ul"),r["\u0275\u0275elementStart"](228,"li"),r["\u0275\u0275text"](229," This is OAuth scope that the \u201cClient Adapter\u201d will request during the authorisation. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](230,"li"),r["\u0275\u0275text"](231," Absa SSO will only provide the minimum default scope, i.e., OpenID. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](232,"p"),r["\u0275\u0275text"](233," The exact method of configuring your \u201cClient Adapter\u201d will depend on the adapter. We recommend that you refer to the documents for your selected adapter to find the correct way to implement the client configuration, mentioned above, into the adapter. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](234,"p"),r["\u0275\u0275text"](235,"Here are links to the guides for some common Keycloak client adapters:"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](236,"ul"),r["\u0275\u0275elementStart"](237,"li"),r["\u0275\u0275elementStart"](238,"p"),r["\u0275\u0275text"](239,"Java adapters"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](240,"ul"),r["\u0275\u0275elementStart"](241,"li"),r["\u0275\u0275elementStart"](242,"a",5),r["\u0275\u0275text"](243,"https://www.Keycloak.org/docs/latest/securing_apps/#java-adapters"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](244,"li"),r["\u0275\u0275elementStart"](245,"p"),r["\u0275\u0275text"](246,"JavaScript adapter"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](247,"ul"),r["\u0275\u0275elementStart"](248,"li"),r["\u0275\u0275elementStart"](249,"a",6),r["\u0275\u0275text"](250,"https://www.Keycloak.org/docs/latest/securing_apps/#_javascript_adapter"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](251,"li"),r["\u0275\u0275elementStart"](252,"p"),r["\u0275\u0275text"](253,"Node.js adapter"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](254,"ul"),r["\u0275\u0275elementStart"](255,"li"),r["\u0275\u0275elementStart"](256,"a",9),r["\u0275\u0275text"](257,"https://www.Keycloak.org/docs/latest/securing_apps/#_nodejs_adapter"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](258,"li"),r["\u0275\u0275elementStart"](259,"p"),r["\u0275\u0275text"](260,"Other OpenID Connect libraries"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](261,"ul"),r["\u0275\u0275elementStart"](262,"li"),r["\u0275\u0275elementStart"](263,"a",10),r["\u0275\u0275text"](264,"https://www.Keycloak.org/docs/latest/securing_apps/#other-OpenID-connect-libraries"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](265,"h3"),r["\u0275\u0275text"](266,"Testing using the Postman OAuth client"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](267,"p"),r["\u0275\u0275text"](268," During development and testing of your application you will need to obtain access tokens to access the Open Banking APIs. One way to do this, is to use Postman\u2019s built-in OAuth client. In the example below, we show how the configuration that you\u2019ll receive is used to configure the OAuth client in Postman to use the authorisation flow with PKCE on Absa SSO. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](269,"p"),r["\u0275\u0275text"](270,"In this example we will use the following configuration:"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](271,"ul"),r["\u0275\u0275elementStart"](272,"li"),r["\u0275\u0275elementStart"](273,"strong"),r["\u0275\u0275text"](274,"* "),r["\u0275\u0275elementStart"](275,"span",7),r["\u0275\u0275text"](276,"Authentication endpoint URL:"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275text"](277,"* "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](278,"strong"),r["\u0275\u0275text"](279,"* "),r["\u0275\u0275elementStart"](280,"u"),r["\u0275\u0275elementStart"](281,"span",7),r["\u0275\u0275elementStart"](282,"a",11),r["\u0275\u0275text"](283,"https://absaauth-uat.absabank.co.ke/auth/realms/sandbox/protocol/OpenID-connect/"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275text"](284,"auth in "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275text"](285,"* "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](286,"li"),r["\u0275\u0275elementStart"](287,"strong"),r["\u0275\u0275text"](288,"* "),r["\u0275\u0275elementStart"](289,"span",7),r["\u0275\u0275text"](290,"Access token endpoint URL: "),r["\u0275\u0275elementStart"](291,"a",12),r["\u0275\u0275elementStart"](292,"u"),r["\u0275\u0275text"](293,"https://absaauth-uat.absabank.co.ke/auth/realms/sandbox/protocol/OpenID-connect/"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275text"](294,"* "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](295,"a",12),r["\u0275\u0275elementStart"](296,"strong"),r["\u0275\u0275text"](297,"* "),r["\u0275\u0275elementStart"](298,"u"),r["\u0275\u0275elementStart"](299,"span",7),r["\u0275\u0275text"](300,"token"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275text"](301,"* "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](302,"li"),r["\u0275\u0275elementStart"](303,"strong"),r["\u0275\u0275text"](304,"* "),r["\u0275\u0275elementStart"](305,"span",7),r["\u0275\u0275text"](306,"Client ID: sandboxclient"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275text"](307,"* "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](308,"li"),r["\u0275\u0275elementStart"](309,"strong"),r["\u0275\u0275text"](310,"* "),r["\u0275\u0275elementStart"](311,"span",7),r["\u0275\u0275text"](312,"Code challenge method: SHA-256 5Scope: OpenID`"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275text"](313,"* "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](314,"p"),r["\u0275\u0275text"](315," You will have received this configuration from Absa after your client has been configured on Absa SSO. In this example, a \u201cClient Secret\u201d is provided. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](316,"p"),r["\u0275\u0275text"](317," For the purposes of development and testing, Absa will provide test user credentials which will allow you to retrieve access tokens. Additionally, for this example a \u201cState\u201d parameter is provided for demo purposes. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](318,"ul"),r["\u0275\u0275elementStart"](319,"li"),r["\u0275\u0275elementStart"](320,"strong"),r["\u0275\u0275text"](321,"* "),r["\u0275\u0275elementStart"](322,"span",7),r["\u0275\u0275text"](323,"Username: sandboxuser1"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275text"](324,"* "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](325,"li"),r["\u0275\u0275elementStart"](326,"strong"),r["\u0275\u0275text"](327,"* "),r["\u0275\u0275elementStart"](328,"span",7),r["\u0275\u0275text"](329,"Password: sEc6mH5VZ8d5"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275text"](330,"* "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](331,"li"),r["\u0275\u0275elementStart"](332,"strong"),r["\u0275\u0275text"](333,"* "),r["\u0275\u0275elementStart"](334,"span",7),r["\u0275\u0275text"](335,"State: 4568947589687"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275text"](336,"* "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](337,"p"),r["\u0275\u0275text"](338," The \u201cState\u201d parameter will not be provided as part of the client configuration. This parameter must be used by the client application to pass on the consent ID for the consent that the application is requesting from the Absa customer. The consent ID will have been provided by the Open Banking Consent request APIs that are used to request payment initiation and account information consent requests. The consent ID is unique to each Open Banking request and cannot be re-used. Refer to the Payment Consent Request API documentation and the account information consent request API documentation for more information. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](339,"h4"),r["\u0275\u0275text"](340,"Steps"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](341,"p"),r["\u0275\u0275text"](342," 1. Create a new request in your Postman collection that is specifically for the purpose of requesting access tokens from Absa SSO. You can then store the token in a variable to be used by the Open Banking API requests in your collection. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](343,"p"),r["\u0275\u0275element"](344,"img",13),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](345,"p"),r["\u0275\u0275text"](346," Example: Click on \u201cAdd a request\u201d to create the first request in a collection. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](347,"p"),r["\u0275\u0275element"](348,"img",14),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](349,"p"),r["\u0275\u0275text"](350," Example: A request called \u201cRequest an access token\u201d is created in the Sandbox collection. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](351,"p"),r["\u0275\u0275text"](352," 2. In the Authorization tab, click on the Type dropdown and select OAuth 2.0. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](353,"div",2),r["\u0275\u0275elementStart"](354,"p"),r["\u0275\u0275element"](355,"img",15),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](356,"p"),r["\u0275\u0275text"](357," 3. The pane to the right of that will allow you to Configure New Token. Select and fill in the fields as follows: "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](358,"ol"),r["\u0275\u0275elementStart"](359,"li"),r["\u0275\u0275elementStart"](360,"p"),r["\u0275\u0275text"](361," Token name - Provide a name to identify this token. e.g., Sandbox access token "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](362,"li"),r["\u0275\u0275elementStart"](363,"p"),r["\u0275\u0275text"](364," Grant type - Select the grant type based on the information that Absa has provided. If you have been provided with a \u201cClient ID\u201d and Client secret, then you must select Authorization Code. If you have not been provided with a Client secret, which is the case in this example, you must select Authorization Code (With PKCE). Refer to the next section for more information. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](365,"li"),r["\u0275\u0275elementStart"](366,"p"),r["\u0275\u0275text"](367," Callback URL \u2013 Postman will prepopulate the callback URL with the global shortened URL for Postman. You do not need to change this. Just tick the \u201cAuthorize Using Browser\u201d option. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](368,"div",16),r["\u0275\u0275elementStart"](369,"p"),r["\u0275\u0275element"](370,"img",17),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](371,"p"),r["\u0275\u0275text"](372,"Token Name configuration"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](373,"p"),r["\u0275\u0275text"](374," d. Auth URL \u2013 Provide the authorisation URL that Absa provided e.g. "),r["\u0275\u0275elementStart"](375,"a",18),r["\u0275\u0275text"](376,"https://absaauthuat.absabank.co.ke/auth/realms/sandbox/protocol/OpenID-connect/auth"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](377,"p"),r["\u0275\u0275text"](378," e. Access token URL \u2013 Provide the Token URL that Absa provided e.g. "),r["\u0275\u0275elementStart"](379,"a",12),r["\u0275\u0275text"](380,"https://absaauthuat.absabank.co.ke/auth/realms/sandbox/protocol/OpenID-connect/token"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](381,"p"),r["\u0275\u0275text"](382," f. \u201cClient ID\u201d \u2013 Provide the \u201cClient ID\u201d that Absa provided e.g., sandboxclient "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](383,"p"),r["\u0275\u0275element"](384,"img",19),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](385,"p"),r["\u0275\u0275text"](386,"URLs and \u201cClient ID\u201d configuration"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](387,"p"),r["\u0275\u0275text"](388," g. \u201cClient Secret\u201d - If you have been provided with a \u201cClient Secret\u201d for your client, insert it here. In most cases, you will not be provided with a Client secret, so you can leave this field blank. h. Code Challenge Method - Select the Code Challenge Method from the drop-down list, i.e., SHA-256 "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](389,"p"),r["\u0275\u0275element"](390,"img",20),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](391,"p"),r["\u0275\u0275text"](392,"Code Challenge Method configuration"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](393,"p"),r["\u0275\u0275text"](394,"i. Scope - Only provide this one scope i.e., OpenID"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](395,"p"),r["\u0275\u0275text"](396," j. State - This parameter must contain a valid consent ID. This consent ID must be obtained from one of the consent request APIs. The consent ID will be unique to each request and will only be valid for a single use, e.g., 4568947589687 "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](397,"p"),r["\u0275\u0275element"](398,"img",21),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](399,"p"),r["\u0275\u0275text"](400,"Scope and State configuration"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](401,"p"),r["\u0275\u0275text"](402," 4. Once all the fields are correctly populated, you can request an access token using the Get New Access Token button. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](403,"p"),r["\u0275\u0275text"](404," 5. A new browser window will be opened, and you will be presented with the Absa authorisation login screen. Enter the username and password for the digital account that has been provided for your testing. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](405,"div",2),r["\u0275\u0275elementStart"](406,"p"),r["\u0275\u0275element"](407,"img",22),r["\u0275\u0275text"](408," Enter username and password "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](409,"p"),r["\u0275\u0275text"](410," The details of the consent are provided to you. This example is a payment request therefore payment details are displayed. Click the Accept button to authorise the request and provide consent for it. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](411,"p"),r["\u0275\u0275element"](412,"img",4),r["\u0275\u0275text"](413," Click Accept to authorise the payment "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](414,"p"),r["\u0275\u0275text"](415," The Absa authorisation screen will close, and you will be directed back to Postman. A pop-up in Postman will contain the access token which you will need to store for subsequent requests where the token is required in the Header called \u201cX-Absa-Client-Auth\u201d. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](416,"blockquote"),r["\u0275\u0275elementStart"](417,"p"),r["\u0275\u0275elementStart"](418,"strong"),r["\u0275\u0275text"](419,"* "),r["\u0275\u0275elementStart"](420,"span",7),r["\u0275\u0275text"](421,"The digital account credentials (username and password) that you use here must be the owner of the account for whom your consent ID was provided."),r["\u0275\u0275elementEnd"](),r["\u0275\u0275text"](422,"* "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](423,"p"),r["\u0275\u0275elementStart"](424,"strong"),r["\u0275\u0275text"](425,"* "),r["\u0275\u0275elementStart"](426,"span",7),r["\u0275\u0275text"](427,"In the case of a Payment Initiation Consent, the credentials must be the owner of the debit account that was provided in the payment consent request. In the case of an Account Information Consent, the credentials must be the owner of the account provided in the account information consent request."),r["\u0275\u0275elementEnd"](),r["\u0275\u0275text"](428,"* "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](429,"h3"),r["\u0275\u0275text"](430,"Authorization Code with PKCE"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](431,"p"),r["\u0275\u0275text"](432," It\u2019s important to note that when using client-side applications there is no secure way to store client credentials in a client-side application. For most cases, Absa will create the client on Absa SSO as a \u201cPublic\u201d access client. Public clients are not required to provide client secrets. Public clients are secure when HTTPS is strictly enforced and redirect URIs registered for the client are strictly controlled. HTML5/JavaScript clients have to be public clients because there is no way to securely transmit the \u201cClient Secret\u201d to HTML5/JavaScript clients. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](433,"p"),r["\u0275\u0275text"](434," Additionally, Absa SSO will require that the Authorization Code flow is used with Proof Ke "),r["\u0275\u0275elementStart"](435,"a",8),r["\u0275\u0275text"](436,"y for Code Exchange"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275text"](437," (PKCE). Absa SSO will require that the client use the SHA256-based PKCE method. To enable the use of this method with the JavaScript client adapter, the following option is passed in the init() method: "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](438,"blockquote"),r["\u0275\u0275elementStart"](439,"p"),r["\u0275\u0275elementStart"](440,"strong"),r["\u0275\u0275text"](441,"* "),r["\u0275\u0275elementStart"](442,"span",7),r["\u0275\u0275text"](443,'pkceMethod - The method for Proof Key Code Exchange (PKCE) to use. Configuring this value enables the PKCE mechanism. Available options: == "S256" - The SHA256 based PKCE method'),r["\u0275\u0275elementEnd"](),r["\u0275\u0275text"](444,"* "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](445,"p"),r["\u0275\u0275text"](446," Refer to the Keycloak documents for more information: "),r["\u0275\u0275elementStart"](447,"a",23),r["\u0275\u0275text"](448,"Securing Applications and Services Guide"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"]())},styles:['@charset "UTF-8";@media (max-width:576px){[_nghost-%COMP%]     .page-content{padding:5px 5px 40px}}[_nghost-%COMP%]     img{max-width:100%;max-height:100%;display:block}[_nghost-%COMP%]     .screen1 img{width:100%;height:100%;max-width:620px;max-height:540px;display:block}[_nghost-%COMP%]     .screen2 