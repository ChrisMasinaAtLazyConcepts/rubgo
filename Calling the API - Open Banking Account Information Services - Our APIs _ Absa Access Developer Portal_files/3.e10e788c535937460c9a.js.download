t"](36,"td"),r["\u0275\u0275text"](37," API Gateway "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](38,"td"),r["\u0275\u0275elementStart"](39,"p"),r["\u0275\u0275text"](40,"An API Gateway sits between clients and services. It acts as a reverse proxy, routing requests from clients to services. It may also perform various cross-cutting tasks such as authentication, SSL termination, and rate limiting."),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](41,"p"),r["\u0275\u0275text"](42,"For most microservices based applications, it makes sense to implement an API Gateway, which acts as a single entry-point into a system. The API Gateway is responsible for request routing, composition, and protocol translation. It provides each of the application's clients with a custom API."),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](43,"tr"),r["\u0275\u0275elementStart"](44,"td"),r["\u0275\u0275text"](45," System User or Service User "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](46,"td"),r["\u0275\u0275text"](47," This is a construct used within the Absa Access domain. (BackEnd User) The BackendUser is the entity that will manage access to the downstream systems that the APIs expose to a specific external client. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](48,"tr"),r["\u0275\u0275elementStart"](49,"td"),r["\u0275\u0275text"](50," OAuth client "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](51,"td"),r["\u0275\u0275text"](52," Used to secure the API at a corporate level. It is also used to give course-grained access to APIs via the concept of scopes. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](53,"tr"),r["\u0275\u0275elementStart"](54,"td"),r["\u0275\u0275text"](55," User "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](56,"td"),r["\u0275\u0275text"](57," The person who wants to be authenticated to access protected information "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](58,"tr"),r["\u0275\u0275elementStart"](59,"td"),r["\u0275\u0275text"](60," ClientID "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](61,"td"),r["\u0275\u0275text"](62," Inside the OAuth client there is a unique ID = ClientID. The OAuth/ClientID is used to identify the calling application. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](63,"tr"),r["\u0275\u0275elementStart"](64,"td"),r["\u0275\u0275text"](65," Scope "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](66,"td"),r["\u0275\u0275text"](67," A list of permits the application asks from the user. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](68,"tr"),r["\u0275\u0275elementStart"](69,"td"),r["\u0275\u0275text"](70," Grant "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](71,"td"),r["\u0275\u0275text"](72," This is a method of acquiring an access token. There are four modalities:"),r["\u0275\u0275element"](73,"br"),r["\u0275\u0275element"](74,"br"),r["\u0275\u0275elementStart"](75,"ul"),r["\u0275\u0275elementStart"](76,"li"),r["\u0275\u0275text"](77,"Authorisation code grant"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](78,"li"),r["\u0275\u0275text"](79,"Implicit grant"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](80,"li"),r["\u0275\u0275text"](81,"Client credential grant"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](82,"li"),r["\u0275\u0275text"](83,"Password grant"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](84,"tr"),r["\u0275\u0275elementStart"](85,"td"),r["\u0275\u0275text"](86," API user "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](87,"td"),r["\u0275\u0275text"](88," This is a new construct that we created within the Absa Access domain. The API user is the entity that will manage access to the downstream systems that APIs expose to a specific external client. It is a class (type off) the service user. Certificates and entitlements can be attached to an API user. Finer grained entitlements have been done this way. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"]())},styles:[""]}),e}(),vt=function(){function e(){}return e.prototype.ngOnInit=function(){},e.\u0275fac=function(t){return new(t||e)},e.\u0275cmp=r["\u0275\u0275defineComponent"]({type:e,selectors:[["app-references-gateway-responses"]],decls:282,vars:0,consts:[[1,"page-content"],[1,"header-image-container","gradient"],[1,"heading","only"],["src","/assets/images/documentation/references/references-banner.png","alt","References",1,"header-image"],[1,"card-container"],[1,"card","innercard","card--simple"],[1,"card-block"],[1,"card-block-inner"],[1,"margins"],["target","_blank","href","https://cs.stanford.edu/people/miles/iso8859.html"]],template:function(e,t){1&e&&(r["\u0275\u0275elementStart"](0,"div",0),r["\u0275\u0275elementStart"](1,"div",1),r["\u0275\u0275elementStart"](2,"h2",2),r["\u0275\u0275text"](3,"Gateway responses"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275element"](4,"img",3),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](5,"div",4),r["\u0275\u0275elementStart"](6,"solar-card"),r["\u0275\u0275elementStart"](7,"div",5),r["\u0275\u0275elementStart"](8,"div",6),r["\u0275\u0275elementStart"](9,"div",7),r["\u0275\u0275elementStart"](10,"h3"),r["\u0275\u0275text"](11," UserNotAuthorized "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](12,"p",8),r["\u0275\u0275text"](13," HTTP Status Code: 401"),r["\u0275\u0275element"](14,"br"),r["\u0275\u0275text"](15," Description: The access token received by the gateway on the request failed the validation procedure."),r["\u0275\u0275element"](16,"br"),r["\u0275\u0275text"](17," Cause: An access invalid token was supplied."),r["\u0275\u0275element"](18,"br"),r["\u0275\u0275text"](19," Resolution: Ensure that the token provided in the request has been retrieved from the correct authority, and that the gateway resource is included in the audience of the token. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](20,"h3"),r["\u0275\u0275text"](21," InvalidScope "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](22,"p",8),r["\u0275\u0275text"](23," HTTP Status Code: 401"),r["\u0275\u0275element"](24,"br"),r["\u0275\u0275text"](25," Description: The access token received by the gateway does not contain a necessary scope."),r["\u0275\u0275element"](26,"br"),r["\u0275\u0275text"](27," Cause: An access invalid token was supplied."),r["\u0275\u0275element"](28,"br"),r["\u0275\u0275text"](29," Resolution: Ensure that the necessary scopes are requested when generating the access token. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](30,"h3"),r["\u0275\u0275text"](31," UserNotEntitledForResource "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](32,"p",8),r["\u0275\u0275text"](33," HTTP Status Code: 403"),r["\u0275\u0275element"](34,"br"),r["\u0275\u0275text"](35," Description: The API user used to generate the access token does not have the necessary entitlements for the requested product."),r["\u0275\u0275element"](36,"br"),r["\u0275\u0275text"](37," Cause: The API user does not have any known entitlements to the requested product."),r["\u0275\u0275element"](38,"br"),r["\u0275\u0275text"](39," Resolution: First determine whether the API user in question should have access to the requested product. Update the permissions for the API user via Client Management. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](40,"h3"),r["\u0275\u0275text"](41," BearerTokenNotLinkedToCertificate "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](42,"p",8),r["\u0275\u0275text"](43," HTTP Status Code: 401"),r["\u0275\u0275element"](44,"br"),r["\u0275\u0275text"](45," Description: No confirmation claim was found in the access token."),r["\u0275\u0275element"](46,"br"),r["\u0275\u0275text"](47," Cause: The access token acquired from the authority did not include a confirmation claim."),r["\u0275\u0275element"](48,"br"),r["\u0275\u0275text"](49," Resolution: Ensure that the authority used to generate the access token has mTLS enabled. Ensure that a client certificate was included in the request to the mTLS authority. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](50,"h3"),r["\u0275\u0275text"](51," NonceNotFound "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](52,"p",8),r["\u0275\u0275text"](53," HTTP Status Code: 412"),r["\u0275\u0275element"](54,"br"),r["\u0275\u0275text"](55," Description: A known nonce header was not included in the request."),r["\u0275\u0275element"](56,"br"),r["\u0275\u0275text"](57," Cause: Either the nonce header does not exist on the request, or the header name applied at the middleware is not the same as the provided nonce header."),r["\u0275\u0275element"](58,"br"),r["\u0275\u0275text"](59," Resolution: Ensure that a nonce header (default header name is: X-Absa-Nonce) is included in the request. If the header is included with the same response, ensure that the header name is correct as defined in the middleware. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](60,"h3"),r["\u0275\u0275text"](61," NonceIncorrectFormat "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](62,"p",8),r["\u0275\u0275text"](63," HTTP Status Code: 412"),r["\u0275\u0275element"](64,"br"),r["\u0275\u0275text"](65," Description: There is a problem with the nonce header value."),r["\u0275\u0275element"](66,"br"),r["\u0275\u0275text"](67," Cause: Either the nonce header is determined to be empty or has other invalid formatting."),r["\u0275\u0275element"](68,"br"),r["\u0275\u0275text"](69," Resolution: Ensure that the nonce value is present with a plain text value (e.g. GUID string, etc.). "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](70,"h3"),r["\u0275\u0275text"](71," NonceLengthTooLong "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](72,"p",8),r["\u0275\u0275text"](73," HTTP Status Code: 412"),r["\u0275\u0275element"](74,"br"),r["\u0275\u0275text"](75," Description: The value for the nonce header is too long to process."),r["\u0275\u0275element"](76,"br"),r["\u0275\u0275text"](77," Cause: The value for the nonce header is too long to process."),r["\u0275\u0275element"](78,"br"),r["\u0275\u0275text"](79," Resolution: Use a shorter nonce value. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](80,"h3"),r["\u0275\u0275text"](81," NonceInvalid "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](82,"p",8),r["\u0275\u0275text"](83," HTTP Status Code: 400"),r["\u0275\u0275element"](84,"br"),r["\u0275\u0275text"](85," Description: The nonce provided is not valid."),r["\u0275\u0275element"](86,"br"),r["\u0275\u0275text"](87," Cause: The nonce provided has already been used within the known time frame."),r["\u0275\u0275element"](88,"br"),r["\u0275\u0275text"](89," Resolution: Ensure that all nonce values provided are unique for the known time frame. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](90,"h3"),r["\u0275\u0275text"](91," InteractionIdInvalid "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](92,"p",8),r["\u0275\u0275text"](93," HTTP Status Code: 412"),r["\u0275\u0275element"](94,"br"),r["\u0275\u0275text"](95," Description: The interaction ID is not valid."),r["\u0275\u0275element"](96,"br"),r["\u0275\u0275text"](97," Cause: Either the interaction ID provided is empty or is too long to be processed."),r["\u0275\u0275element"](98,"br"),r["\u0275\u0275text"](99," Resolution: Ensure that the interaction ID is not empty or shorten it (the default max length processed is 86 characters). "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](100,"h3"),r["\u0275\u0275text"](101," RateLimitExceeded "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](102,"p",8),r["\u0275\u0275text"](103," HTTP Status Code: 429"),r["\u0275\u0275element"](104,"br"),r["\u0275\u0275text"](105," Description: The number of requests processed exceeds the limit defined for the time frame."),r["\u0275\u0275element"](106,"br"),r["\u0275\u0275text"](107," Cause: Too many requests have already been processed for the time frame."),r["\u0275\u0275element"](108,"br"),r["\u0275\u0275text"](109," Resolution: Wait for the time frame to reset for the period before sending more requests. Extend the rate limit for the allowed requests. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](110,"h3"),r["\u0275\u0275text"](111," CertificateNotSupplied "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](112,"p",8),r["\u0275\u0275text"](113," HTTP Status Code: 401"),r["\u0275\u0275element"](114,"br"),r["\u0275\u0275text"](115," Description: The middleware requires a client certificate and one could not be found on the request."),r["\u0275\u0275element"](116,"br"),r["\u0275\u0275text"](117," Cause: Inability to find a client certificate on the request."),r["\u0275\u0275element"](118,"br"),r["\u0275\u0275text"](119," Resolution: Ensure that a client certificate is attached to the request. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](120,"h3"),r["\u0275\u0275text"](121," CertificateMismatch "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](122,"p",8),r["\u0275\u0275text"](123," HTTP Status Code: 401"),r["\u0275\u0275element"](124,"br"),r["\u0275\u0275text"](125," Description: The confirmation token found on the access token does not match the thumbprint found on the client certificate."),r["\u0275\u0275element"](126,"br"),r["\u0275\u0275text"](127," Cause: The confirmation token value is empty or the value does not match the thumbprint of the provided client certificate."),r["\u0275\u0275element"](128,"br"),r["\u0275\u0275text"](129," Resolution: Ensure that the access token was retrieved from an authority that is mTLS enabled. Ensure that the same client certificate used for the request to the gateway was used to generate an access token. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](130,"h3"),r["\u0275\u0275text"](131," CertificateExpired "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](132,"p",8),r["\u0275\u0275text"](133," HTTP Status Code: 401"),r["\u0275\u0275element"](134,"br"),r["\u0275\u0275text"](135," Description: On validation it was found that the client certificate has expired."),r["\u0275\u0275element"](136,"br"),r["\u0275\u0275text"](137," Cause: The client certificate has expired."),r["\u0275\u0275element"](138,"br"),r["\u0275\u0275text"](139," Resolution: Generate a new client certificate to be used on requests. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](140,"h3"),r["\u0275\u0275text"](141," MessageSignatureMissingOrInvalid "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](142,"p",8),r["\u0275\u0275text"](143," HTTP Status Code: 412"),r["\u0275\u0275element"](144,"br"),r["\u0275\u0275text"](145," Description: The signature header required for message signing was not found on the request."),r["\u0275\u0275element"](146,"br"),r["\u0275\u0275text"](147," Cause: The message signing header name Signature was not found on the request."),r["\u0275\u0275element"](148,"br"),r["\u0275\u0275text"](149," Resolution: Ensure that the header with name Signature is present on requests. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](150,"h3"),r["\u0275\u0275text"](151," MessageSignatureKeyIdMissingInSignatureHeader "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](152,"p",8),r["\u0275\u0275