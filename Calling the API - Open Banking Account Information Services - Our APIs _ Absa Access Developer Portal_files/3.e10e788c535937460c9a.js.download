r["\u0275\u0275elementStart"](24,"td"),r["\u0275\u0275text"](25,"API"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](26,"td"),r["\u0275\u0275text"](27,"Application Programming Interface"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](28,"tr",2),r["\u0275\u0275elementStart"](29,"td"),r["\u0275\u0275text"](30,"IdP"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](31,"td"),r["\u0275\u0275text"](32,"Identity Provider"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](33,"tr",3),r["\u0275\u0275elementStart"](34,"td"),r["\u0275\u0275text"](35,"AAAGW"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](36,"td"),r["\u0275\u0275text"](37,"Absa Access API Gateway"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](38,"tr",2),r["\u0275\u0275elementStart"](39,"td"),r["\u0275\u0275text"](40,"PSU"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](41,"td"),r["\u0275\u0275elementStart"](42,"p"),r["\u0275\u0275text"](43,"Payment Service User"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](44,"ul"),r["\u0275\u0275elementStart"](45,"li"),r["\u0275\u0275elementStart"](46,"p"),r["\u0275\u0275text"](47," An active Absa-banked client using the payment services offered by TPP or PISP "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](48,"tr",3),r["\u0275\u0275elementStart"](49,"td"),r["\u0275\u0275text"](50,"TPP/AISP"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](51,"td"),r["\u0275\u0275elementStart"](52,"p"),r["\u0275\u0275text"](53,"Third Party Provider/Account Information Service Provider"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](54,"ul"),r["\u0275\u0275elementStart"](55,"li"),r["\u0275\u0275elementStart"](56,"p"),r["\u0275\u0275text"](57,"Initiates requests on behalf of a PSU"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](58,"li"),r["\u0275\u0275elementStart"](59,"p"),r["\u0275\u0275text"](60," The TPP is onboarded onto the Absa platform and set up to use the open banking payment services with appropriate entitlements. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](61,"tr",2),r["\u0275\u0275elementStart"](62,"td"),r["\u0275\u0275text"](63,"ASPSP"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](64,"td"),r["\u0275\u0275elementStart"](65,"p"),r["\u0275\u0275text"](66,"Account Servicing Payment Service Provider (Absa)"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](67,"ul"),r["\u0275\u0275elementStart"](68,"li"),r["\u0275\u0275elementStart"](69,"p"),r["\u0275\u0275text"](70,"This is the entity where the payment accounts reside."),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](71,"li"),r["\u0275\u0275elementStart"](72,"p"),r["\u0275\u0275text"](73," It provides and maintains a payment account for a payer and, in the context of the open banking ecosystem, are entities that publish read/write APIs to permit, with customers\u2019 consent, payments initiated by third-party providers and/or make their customers\u2019 account transaction data available to third-party providers via their API end points. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](74,"li"),r["\u0275\u0275elementStart"](75,"p"),r["\u0275\u0275text"](76,"Absa performs this role in the account information flow."),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](77,"h2"),r["\u0275\u0275text"](78,"Process flow"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](79,"p"),r["\u0275\u0275text"](80," The following process provides a general outline of an account information request and flow using the account information APIs. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](81,"p"),r["\u0275\u0275element"](82,"img",4),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](83,"h2"),r["\u0275\u0275text"](84,"Process steps"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](85,"table"),r["\u0275\u0275elementStart"](86,"colgroup"),r["\u0275\u0275element"](87,"col"),r["\u0275\u0275element"](88,"col"),r["\u0275\u0275element"](89,"col"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](90,"thead"),r["\u0275\u0275elementStart"](91,"tr",1),r["\u0275\u0275elementStart"](92,"th"),r["\u0275\u0275elementStart"](93,"strong"),r["\u0275\u0275text"](94,"Steps"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](95,"th"),r["\u0275\u0275elementStart"](96,"strong"),r["\u0275\u0275text"](97,"Actor/Platform"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](98,"th"),r["\u0275\u0275elementStart"](99,"strong"),r["\u0275\u0275text"](100,"Process description"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](101,"tbody"),r["\u0275\u0275elementStart"](102,"tr",2),r["\u0275\u0275elementStart"](103,"td"),r["\u0275\u0275text"](104,"Step 1: Request account information"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](105,"td"),r["\u0275\u0275text"](106,"PSU/TPP"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](107,"td"),r["\u0275\u0275elementStart"](108,"p"),r["\u0275\u0275text"](109," The consent process is initiated with a PSU creating intent to access account information data on the TPP\u2019s platform. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](110,"ul"),r["\u0275\u0275elementStart"](111,"li"),r["\u0275\u0275elementStart"](112,"p"),r["\u0275\u0275text"](113," The consent is between the PSU (an Absa-banked client) and the AISP (TPP). "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](114,"tr",3),r["\u0275\u0275elementStart"](115,"td"),r["\u0275\u0275text"](116,"Step 2: Authenticate on Absa API Gateway"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](117,"td"),r["\u0275\u0275text"](118,"AISP (TPP)/AAAG"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](119,"td"),r["\u0275\u0275elementStart"](120,"p"),r["\u0275\u0275text"](121," The AISP/TPP will authenticate via Absa\u2019s IdP to get a valid authentication token, which will be used in subsequent calls submitted via the Absa Access API gateway. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](122,"ul"),r["\u0275\u0275elementStart"](123,"li"),r["\u0275\u0275elementStart"](124,"p"),r["\u0275\u0275text"](125," The authentication details will be provided after the onboarding is completed on Absa Access and the OAuth client was generated and their certificate is enrolled. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](126,"li"),r["\u0275\u0275elementStart"](127,"p"),r["\u0275\u0275text"](128," An access token expires every 10 minutes, a new authentication request is required, and the token needs to be updated in subsequent requests. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](129,"p"),r["\u0275\u0275text"](130," The step is carried out by making a POST request to the Authentication Service. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](131,"p"),r["\u0275\u0275text"](132,"POST/\u2026/connect/token"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](133,"tr",2),r["\u0275\u0275elementStart"](134,"td"),r["\u0275\u0275text"](135,"Step 3: Set up account-access-consents"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](136,"td"),r["\u0275\u0275text"](137,"AISP/TPP"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](138,"td"),r["\u0275\u0275elementStart"](139,"p"),r["\u0275\u0275text"](140," The AISP/TPP creates a consent request in the consent management system, which records the details of the permission request and returns a ConsentId. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](141,"ul"),r["\u0275\u0275elementStart"](142,"li"),r["\u0275\u0275elementStart"](143,"p"),r["\u0275\u0275text"](144," The AISP connects to Absa as the ASPSP that services the AIS account and creates a new account-access-consents resource. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](145,"li"),r["\u0275\u0275elementStart"](146,"p"),r["\u0275\u0275text"](147," Absa as the ASPSP validates the request and responds with the ConsentId, which is the intent identifier for the account-access calls. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](148,"p"),r["\u0275\u0275text"](149," This step is carried out by making a POST request to the account-access-consents resource. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](150,"p"),r["\u0275\u0275text"](151,"POST/account-access-consents"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](152,"tr",3),r["\u0275\u0275elementStart"](153,"td"),r["\u0275\u0275text"](154,"Step 4: Authorise consent"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](155,"td"),r["\u0275\u0275text"](156,"PSU/ASPSP (Absa)"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](157,"td"),r["\u0275\u0275elementStart"](158,"p"),r["\u0275\u0275text"](159," The AISP requests the PSU to authorise the consent by redirecting the PSU to an Absa banking channel to log in, view and authorise the consent. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](160,"ul"),r["\u0275\u0275elementStart"](161,"li"),r["\u0275\u0275elementStart"](162,"p"),r["\u0275\u0275text"](163," The redirect includes the ConsentId generated in the previous step. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](164,"li"),r["\u0275\u0275elementStart"](165,"p"),r["\u0275\u0275text"](166," This allows Absa as the ASPSP to correlate the account-access-consents that were set up. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](167,"li"),r["\u0275\u0275elementStart"](168,"p"),r["\u0275\u0275text"](169,"Absa authenticates the PSU."),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](170,"li"),r["\u0275\u0275elementStart"](171,"p"),r["\u0275\u0275text"](172," Absa updates the state of the account-access-consents resource internally to indicate that the consent has been authorised. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](173,"li"),r["\u0275\u0275elementStart"](174,"p"),r["\u0275\u0275text"](175," Once the consent has been authorised, the PSU is redirected back to the AISP/TPP. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](176,"li"),r["\u0275\u0275elementStart"](177,"p"),r["\u0275\u0275text"](178," The consent is managed between the PSU and the AISP \u2013 so the account-access-consents details must not be changed (with the ASPSP). The PSU will only be able to authorise or reject the account-access-consents details in its entirety. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](179,"li"),r["\u0275\u0275elementStart"](180,"p"),r["\u0275\u0275text"](181," During authorisation, the PSU selects the accounts that are authorised for the AISP request. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](182,"p"),r["\u0275\u0275text"](183," This step is initiated on the TPP platform and authorised by the PSU on the Absa banking channel, using their Absa login credentials. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](184,"p"),r["\u0275\u0275text"](185," Please refer to the section Absa Client Auth SSO \u2013 Developer Guide. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](186,"tr",2),r["\u0275\u0275elementStart"](187,"td"),r["\u0275\u0275text"](188,"Step 5: Get consent status"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](189,"td"),r["\u0275\u0275text"](190,"AISP/TPP"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](191,"td"),r["\u0275\u0275elementStart"](192,"p"),r["\u0275\u0275text"](193," The AISP/TPP can check the status of the account access consent resource (with the account access consent resource identifier) "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](194,"ul"),r["\u0275\u0275elementStart"](195,"li"),r["\u0275\u0275elementStart"](196,"p"),r["\u0275\u0275text"](197," View the status of consent using the ConsentId after the consent request was created. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](198,"p"),r["\u0275\u0275text"](199," This is carried out by making a GET request to the account-access-consent resource. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](200,"p"),r["\u0275\u0275text"](201,"GET/.../account-access-consents/:consentId"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"