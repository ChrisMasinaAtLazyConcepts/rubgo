,["href","https://absaauthuat.absabank.co.ke/auth/realms/sandbox/protocol/OpenID-connect/auth"],["src","/assets/images/our-apis/open-banking-account-information-services/Sso.image8.png","alt",""],["src","/assets/images/our-apis/open-banking-account-information-services/Sso.image9.png","alt",""],["src","/assets/images/our-apis/open-banking-account-information-services/Sso.image10.png","alt",""],["src","/assets/images/our-apis/open-banking-account-information-services/Sso.image11.png","alt",""],["href","https://www.keycloak.org/docs/latest/securing_apps/#_javascript_adapter"]],template:function(e,t){1&e&&(r["\u0275\u0275elementStart"](0,"div",0),r["\u0275\u0275elementStart"](1,"h1"),r["\u0275\u0275text"](2,"Absa Client OAuth SSO - Developer Guide"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](3,"p"),r["\u0275\u0275text"](4," This guide contains the information and steps required to use the ARO SSO environment for the Open Banking consent part. The guide is for third-party developers (Corporate and FinTech) to integrate with their applications. The content below is intended to be published to the Absa Access API developer portal. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](5,"h2"),r["\u0275\u0275text"](6,"Open Banking Consent - OAuth client"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](7,"h3"),r["\u0275\u0275text"](8,"Introduction"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](9,"p"),r["\u0275\u0275text"](10," In addition to the OAuth Client, documented here "),r["\u0275\u0275elementStart"](11,"a",1),r["\u0275\u0275text"](12,"Absa Access Developer Portal,"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275text"](13," that needs to be created to authenticate access to the "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](14,"p"),r["\u0275\u0275text"](15," Absa APIs, a second and separate OAuth client registration needs to take place. This second OAuth client registration is within the Absa SSO environment and is required to use the Open Banking APIs. The Absa SSO environment provides the authentication and consent application that the Absa customer will use to provide the consent required to use the Open Banking Payment Initiation and Account Information APIs. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](16,"p"),r["\u0275\u0275text"](17," The Open Banking OAuth Consent client uses the OpenID Connect protocol with a redirection flow, known as the authorisation code flow, to allow Absa banking customers to authenticate and provide consent for payment and information requests for their Absa accounts in an Absa-provided environment. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](18,"p"),r["\u0275\u0275text"](19," This is the Absa SSO login page with which customers will be presented after being re-directed to the Absa SSO environment: "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](20,"p"),r["\u0275\u0275text"](21," After successfully logging in, a customer will be presented with a consent page. This is the consent page for a payment initiation request: "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](22,"p"),r["\u0275\u0275element"](23,"img",2),r["\u0275\u0275element"](24,"br"),r["\u0275\u0275element"](25,"br"),r["\u0275\u0275text"](26,"Absa SSO login screen "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](27,"p"),r["\u0275\u0275element"](28,"img",3),r["\u0275\u0275element"](29,"br"),r["\u0275\u0275text"](30,"Absa SSO payment consent screen "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](31,"h3"),r["\u0275\u0275text"](32,"Getting started"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](33,"p"),r["\u0275\u0275text"](34," Before you can configure an Open Banking OAuth Consent client for your web or mobile app, Absa will first need to create and configure your client on the Absa SSO environment. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](35,"p"),r["\u0275\u0275text"](36,"The following information needs to be provided to Absa:"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](37,"p"),r["\u0275\u0275elementStart"](38,"strong"),r["\u0275\u0275text"](39,"OAuth Client Adapter"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](40,"ul"),r["\u0275\u0275elementStart"](41,"li"),r["\u0275\u0275text"](42," Absa will need to know which adapter type you will be using. This can be one of the adapters provided by Keycloak, other providers or a custom adapter e.g., Java adapter, Nodejs adapter, etc. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](43,"li"),r["\u0275\u0275text"](44," This information is required by Absa to ensure that your client is correctly and securely configured on the Absa SSO environment. Absa may request or provide additional information based on the \u201cClient Adapter\u201d that you use. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](45,"ul"),r["\u0275\u0275elementStart"](46,"li"),r["\u0275\u0275elementStart"](47,"p"),r["\u0275\u0275elementStart"](48,"strong"),r["\u0275\u0275text"](49,"Origin URL"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](50,"ul"),r["\u0275\u0275elementStart"](51,"li"),r["\u0275\u0275text"](52," This is the URL(s) from which all your application requests to the Absa SSO environment will originate. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](53,"li"),r["\u0275\u0275text"](54," You may provide multiple URLs and these may differ per environment. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](55,"li"),r["\u0275\u0275text"](56," Absa will use these URLs to restrict the allowed CORS origins to secure Absa SSO. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](57,"li"),r["\u0275\u0275elementStart"](58,"p"),r["\u0275\u0275elementStart"](59,"strong"),r["\u0275\u0275text"](60,"Re-direct URI"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](61,"ul"),r["\u0275\u0275elementStart"](62,"li"),r["\u0275\u0275text"](63," This is the URI (s) of your application callback, to which the Absa SSO must re-direct the customer, after the consent has been completed, whether successful or failed. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](64,"li"),r["\u0275\u0275text"](65," You may provide multiple URIs and these may differ per environment. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](66,"li"),r["\u0275\u0275text"](67," These URIs will typically be set up as a callback within your application and have the same hostname as in the origin URL. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](68,"li"),r["\u0275\u0275text"](69," Absa will place these URIs on an \u201cAllowed\u201d list on Absa SSO for your client adapter. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](70,"li"),r["\u0275\u0275text"](71," Even though your \u201cClient Adapter\u201d will send a redirect URI with every request, Absa SSO will confirm that the URI is on the \u201cAllowed\u201d list before allowing the request to be received. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](72,"h3"),r["\u0275\u0275text"](73,"Selecting a client adapter"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](74,"p"),r["\u0275\u0275text"](75," You will need to determine which \u201cClient Adapter\u201d will best suit your application and architecture. Keycloak provides several adapters: "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](76,"ul"),r["\u0275\u0275elementStart"](77,"li"),r["\u0275\u0275elementStart"](78,"p"),r["\u0275\u0275elementStart"](79,"strong"),r["\u0275\u0275text"](80,"Java adapters"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](81,"ul"),r["\u0275\u0275elementStart"](82,"li"),r["\u0275\u0275text"](83," Keycloak comes with a range of different adapters for Java application. Selecting the correct adapter depends on the target platform. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](84,"li"),r["\u0275\u0275elementStart"](85,"a",4),r["\u0275\u0275text"](86,"https://www.Keycloak.org/docs/latest/securing_apps/#java-adapters"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](87,"li"),r["\u0275\u0275elementStart"](88,"p"),r["\u0275\u0275elementStart"](89,"strong"),r["\u0275\u0275text"](90,"JavaScript adapter"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](91,"ul"),r["\u0275\u0275elementStart"](92,"li"),r["\u0275\u0275text"](93," Keycloak comes with a client-side JavaScript library that can be used to secure HTML5/JavaScript applications. The JavaScript adapter has built-in support for Cordova applications. "),r["\u0275\u0275elementStart"](94,"a",5),r["\u0275\u0275text"](95,"https://www.Keycloak.org/docs/latest/securing_apps/#_javascript_adapter"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](96,"p"),r["\u0275\u0275elementStart"](97,"strong"),r["\u0275\u0275elementStart"](98,"em"),r["\u0275\u0275text"](99,"NB NOTE: It is important to note that when using client-side applications, there is no secure way to store client credentials in a client-side application. Absa will require that you use the Authorization Code with PKCE ("),r["\u0275\u0275elementStart"](100,"a",6),r["\u0275\u0275text"](101,"Proof Key"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275text"](102," for "),r["\u0275\u0275elementStart"](103,"a",6),r["\u0275\u0275text"](104," Code Exchange"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275text"](105,") flow."),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](106,"li"),r["\u0275\u0275elementStart"](107,"p"),r["\u0275\u0275elementStart"](108,"strong"),r["\u0275\u0275text"](109,"Node.js adapter"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](110,"ul"),r["\u0275\u0275elementStart"](111,"li"),r["\u0275\u0275text"](112," Keycloak provides a Node.js adapter built on top of Connect to protect server-side JavaScript apps - the goal is to be flexible enough to integrate with frameworks like Express.js. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](113,"li"),r["\u0275\u0275elementStart"](114,"a",7),r["\u0275\u0275text"](115,"https://www.Keycloak.org/docs/latest/securing_apps/#_nodejs_adapter"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](116,"li"),r["\u0275\u0275elementStart"](117,"p"),r["\u0275\u0275elementStart"](118,"strong"),r["\u0275\u0275text"](119,"Other OpenID Connect libraries"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](120,"ul"),r["\u0275\u0275elementStart"](121,"li"),r["\u0275\u0275text"](122," Keycloak can be secured by supplied adapters that are usually easier to use and provide better integration with Keycloak. However, if an adapter is not available for your programming language, framework or platform, you may opt to use a generic OpenID Connect Relying Party (RP) library instead. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](123,"li"),r["\u0275\u0275elementStart"](124,"a",8),r["\u0275\u0275text"](125,"https://www.Keycloak.org/docs/latest/securing_apps/#other-OpenID-connect-libraries"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](126,"h3"),r["\u0275\u0275text"](127,"Configuring your client adapter"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](128,"p"),r["\u0275\u0275text"](129," Once Absa has completed the client configuration on Absa SSO, you will be provided with the following, which you will need for configuring your client adapter. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](130,"ul"),r["\u0275\u0275elementStart"](131,"li"),r["\u0275\u0275elementStart"](132,"p"),r["\u0275\u0275elementStart"](133,"strong"),r["\u0275\u0275text"](134,"Auth server URL"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](135,"ul"),r["\u0275\u0275elementStart"](136,"li"),r["\u0275\u0275text"](137,"This is the Absa SSO server\u2019s base realm URL."),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](138,"li"),r["\u0275\u0275text"](139,"It is also referred to as the \u201cissuer\u201d or \u201ciss\u201d URL."),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](140,"li"),r["\u0275\u0275text"](141," Your \u201cClient Adapter\u201d will use this URL as the base for all Absa SSO requests. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](142,"li"),r["\u0275\u0275text"](143," You will be provided with a URL per environment, i.e., UAT, Pre-prod and Production. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](144,"li"),r["\u0275\u0275elementStart"](145,"p"),r["\u0275\u0275elementStart"](146,"strong"),r["\u0275\u0275text"](147,"Authentication endpoint URL"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](148,"ul"),r["\u0275\u0275elementStart"](149,"li"),r["\u0275\u0275text"](150,"This is the Absa SSO server\u2019s authentication endpoint URL."),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](151,"li"),r["\u0275\u0275text"](152," Your \u201cClient Adapter\u201d will use this endpoint to request a new authentication by re-directing the Absa customer\u2019s browser to this URL. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](153,"li"),r["\u0275\u0275text"](154," You will be provided with a URL per environment, i.e., UAT, Pre-prod and Production. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](155,"li"),r["\u0275\u0275elementStart"](156,"p"),r["\u0275\u0275elementStart"](157,"strong"),r["\u0275\u0275text"](158,"AccessToken endpoint URL"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](159,"ul"),r["\u0275\u0275elementStart"](160,"li"),r["\u0275\u0275text"](161,"This is the Absa SSO server\u2019s token endpoint URL."),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](162,"li"),r["\u0275\u0275text"](163," Your \u201cClient Adapter\u201d will use this endpoint to exchange the authorisation code it received after a successful authorisation, for an Access and Refresh token. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](164,"li"),r["\u0275\u0275text"](165," You will be provided with a URL per environment, i.e., UAT, Pre-prod and Production. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](166,"li"),r["\u0275\u0275elementStart"](167,"p"),r["\u0275\u0275elementStart"](168,"strong"),r["\u0275\u0275text"](169,"OpenID Connect Well-Known URL"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](170,"ul"),r["\u0275\u0275elementStart"](171,"li"),r["\u0275\u0275text"](172," This the URL where Absa SSO publishes its OpenID Connect metadata, also referred to as the discovery document. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](173,"li"),r["\u0275\u0275text"](174," Your \u201cClient Adapter\u201d may use this URL to retrieve the OpenID Connect values it requires. You will be provided with a URL per environment, i.e., UAT, Pre-prod and Production. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](175,"li"),r["\u0275\u0275elementStart"](176,"p"),r["\u0275\u0275elementStart"](177,"strong"),r["\u0275\u0275text"](178,"ClientID"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](179,"ul"),r["\u0275\u0275elementStart"](180,"li"),r["\u0275\u0275text"](181,"The \u201cClient ID\u201d will be unique to your application."),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](182,"li"),r["\u0275\u0275text"](183," Your \u201cClient Adapter\u201d will use this ID to identify your application on Absa SSO requests. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](184,"li"),r["\u0275\u0275text"](185," You will be provided with a \u201cClient ID\u201d per environment, i.e., UAT, Pre-prod and Production. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](186,"li"),r["\u0275\u0275elementStart"](187,"p"),r["\u0275\u0275elementStart"](188,"strong"),r["\u0275\u0275text"](189,"Client secret"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](190,"ul"),r["\u0275\u0275elementStart"](191,"li"),r["\u0275\u0275text"](192," The \u201cClient Secret\u201d will be paired with the \u201cClient ID\u201d and will be unique to your application. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](193,"li"),r["\u0275\u0275text"](194," Your \u201cClient Adapter\u201d will use the secret with Absa SSO requests. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](195,"li"),r["\u0275\u0275text"](196," You will be provided with a \u201cClient Secret\u201d per environment, i.e., UAT, Pre-prod and Production. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](197,"blockquote"),r["\u0275\u0275elementStart"](198,"p"),r["\u0275\u0275text"](199," NB NOTE: The \u201cClient Secret\u201d will only be applicable and provided if your \u201cClient Adapter\u201d type and architecture meet the requirement for the \u201cConfidential\u201d OpenID Connect flow type. In most cases, Absa will not use this flow type. If there is an exception made then \u2014 to meet this requirement \u2014 your \u201cClient Adapter\u201d must not expose the \u201cClient Secret\u201d to the client-side of your application; it must store and use the \u201cClient Secret\u201d on the server-side of the application. As an example, the Keycloak JavaScript \u201cClient Adapter\u201d does not meet this requirement as all code is client-side. Refer to the Code Challenge Method below. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](200,"ul"),r["\u0275\u0275elementStart"](201,"li"),r["\u0275\u0275elementStart"](202,"p"),r["\u0275\u0275elementStart"](203,"strong"),r["\u0275\u0275text"](204,"Code Challenge Method"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](205,"ul"),r["\u0275\u0275elementStart"](206,"li"),r["\u0275\u0275text"](207," This configuration is applicable if your \u201cClient Adapter\u201d needs to use the Authorisation Code Flow with PKCE. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](208,"li"),r["\u0275\u0275text"](209," This flow must be used when your \u201cClient Adapter\u201d cannot secure the \u201cClient Secret\u201d as stated above. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](210,"li"),r["\u0275\u0275text"](211," The value provided is the PKCE challenge method that your \u201cClient Adapter\u201d will use with Absa SSO, i.e., S256. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](212,"li"),r["\u0275\u0275elementStart"](213,"p"),r["\u0275\u0275elementStart"](214,"strong"),r["\u0275\u0275text"](215,"Scope"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](216,"ul"),r["\u0275\u0275elementStart"](217,"li"),r["\u0275\u0275text"](218," This is OAuth scope that the \u201cClient Adapter\u201d will request during the authorisation. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](219,"li"),r["\u0275\u0275text"](220," Absa SSO will only provide the minimum default scope, i.e., OpenID. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](221,"p"),r["\u0275\u0275text"](222," The exact method of configuring your \u201cClient Adapter\u201d will depend on the adapter. We recommend that you refer to the documents for your selected adapter to find the correct way to implement the client configuration, mentioned above, into the adapter. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](223,"p"),r["\u0275\u0275text"](224,"Here are links to the guides for some common Keycloak client adapters:"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](225,"ul"),r["\u0275\u0275elementStart"](226,"li"),r["\u0275\u0275elementStart"](227,"strong"),r["\u0275\u0275text"](228,"Java adapters"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](229,"ul"),r["\u0275\u0275elementStart"](230,"li"),r["\u0275\u0275elementStart"](231,"a",4),r["\u0275\u0275text"](232,"https://www.Keycloak.org/docs/latest/securing_apps/#java-adapters"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](233,"ul"),r["\u0275\u0275elementStart"](234,"li"),r["\u0275\u0275elementStart"](235,"strong"),r["\u0275\u0275text"](236,"JavaScript adapter"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](237,"ul"),r["\u0275\u0275elementStart"](238,"li"),r["\u0275\u0275elementStart"](239,"a",5),r["\u0275\u0275text"](240,"https://www.Keycloak.org/docs/latest/securing_apps/#_javascript_adapter"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](241,"ul"),r["\u0275\u0275elementStart"](242,"li"),r["\u0275\u0275elementStart"](243,"strong"),r["\u0275\u0275text"](244,"Node.js adapter"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](245,"ul"),r["\u0275\u0275elementStart"](246,"li"),r["\u0275\u0275elementStart"](247,"a",7),r["\u0275\u0275text"](248,"https://www.Keycloak.org/docs/latest/securing_apps/#_nodejs_adapter"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](249,"ul"),r["\u0275\u0275elementStart"](250,"li"),r["\u0275\u0275elementStart"](251,"strong"),r["\u0275\u0275text"](252,"Other OpenID Connect libraries"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](253,"ul"),r["\u0275\u0275elementStart"](254,"li"),r["\u0275\u0275elementStart"](255,"a",8),r["\u0275\u0275text"](256,"https://www.Keycloak.org/docs/latest/securing_apps/#other-OpenID-connect-libraries"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](257,"h3"),r["\u0275\u0275text"](258,"Testing using the Postman OAuth client"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](259,"p"),r["\u0275\u0275text"](260," During development and testing of your application you will need to obtain access tokens to access the Open Banking APIs. One way to do this, is to use Postman\u2019s built-in OAuth client. In the example below, we show how the configuration that you\u2019ll receive is used to configure the OAuth client in Postman to use the authorisation flow with PKCE on Absa SSO. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](261,"p"),r["\u0275\u0275text"](262,"In this example we will use the following configuration:"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](263,"ul"),r["\u0275\u0275elementStart"](264,"li"),r["\u0275\u0275elementStart"](265,"p"),r["\u0275\u0275elementStart"](266,"strong"),r["\u0275\u0275text"](267,"Authentication endpoint URL:"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](268,"ul"),r["\u0275\u0275elementStart"](269,"li"),r["\u0275\u0275elementStart"](270,"a",9),r["\u0275\u0275text"](271,"https://absaauth-uat.absabank.co.ke/auth/realms/sandbox/protocol/OpenID-connect/auth"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](272,"li"),r["\u0275\u0275elementStart"](273,"p"),r["\u0275\u0275elementStart"](274,"strong"),r["\u0275\u0275text"](275,"Access token endpoint URL:"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](276,"ul"),r["\u0275\u0275elementStart"](277,"li"),r["\u0275\u0275elementStart"](278,"a",10),r["\u0275\u0275text"](279,"https://absaauth-uat.absabank.co.ke/auth/realms/sandbox/protocol/OpenID-connect/token"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](280,"li"),r["\u0275\u0275elementStart"](281,"p"),r["\u0275\u0275elementStart"](282,"strong"),r["\u0275\u0275text"](283,"Client ID:"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](284,"ul"),r["\u0275\u0275elementStart"](285,"li"),r["\u0275\u0275text"](286,"sandboxclient"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](287,"ul"),r["\u0275\u0275elementStart"](288,"li"),r["\u0275\u0275elementStart"](289,"strong"),r["\u0275\u0275text"](290,"Code challenge method:"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](291,"ul"),r["\u0275\u0275elementStart"](292,"li"),r["\u0275\u0275text"](293,"SHA-256 5Scope: OpenID"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](294,"p"),r["\u0275\u0275text"](295," You will have received this configuration from Absa after your client has been configured on Absa SSO. In this example, a \u201cClient Secret\u201d is provided. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](296,"p"),r["\u0275\u0275text"](297," For the purposes of development and testing, Absa will provide test user credentials which will allow you to retrieve access tokens. Additionally, for this example a \u201cState\u201d parameter is provided for demo purposes. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](298,"ul"),r["\u0275\u0275elementStart"](299,"li"),r["\u0275\u0275elementStart"](300,"p"),r["\u0275\u0275elementStart"](301,"strong"),r["\u0275\u0275text"](302,"Username:"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](303,"ul"),r["\u0275\u0275elementStart"](304,"li"),r["\u0275\u0275text"](305,"sandboxuser1"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](306,"li"),r["\u0275\u0275elementStart"](307,"p"),r["\u0275\u0275elementStart"](308,"strong"),r["\u0275\u0275text"](309,"Password:"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](310,"ul"),r["\u0275\u0275elementStart"](311,"li"),r["\u0275\u0275text"](312,"sEc6mH5VZ8d5"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](313,"li"),r["\u0275\u0275elementStart"](314,"p"),r["\u0275\u0275elementStart"](315,"strong"),r["\u0275\u0275text"](316,"State:"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](317,"ul"),r["\u0275\u0275elementStart"](318,"li"),r["\u0275\u0275text"](319,"4568947589687"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](320,"p"),r["\u0275\u0275text"](321," The \u201cState\u201d parameter will not be provided as part of the client configuration. This parameter must be used by the client application to pass on the consent ID for the consent that the application is requesting from the Absa customer. The consent ID will have been provided by the Open Banking Consent request APIs that are used to request payment initiation and account information consent requests. The consent ID is unique to each Open Banking request and cannot be re-used. Refer to the Payment Consent Request API documentation and the account information consent request API documentation for more information. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](322,"h4"),r["\u0275\u0275text"](323,"Steps"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](324,"p"),r["\u0275\u0275text"](325," 1. Create a new request in your Postman collection that is specifically for the purpose of requesting access tokens from Absa SSO. You can then store the token in a variable to be used by the Open Banking API requests in your collection. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](326,"p"),r["\u0275\u0275element"](327,"img",11),r["\u0275\u0275element"](328,"br"),r["\u0275\u0275text"](329,"Example: Click on \u201cAdd a request\u201d to create the first request in a collection. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](330,"p"),r["\u0275\u0275element"](331,"img",12),r["\u0275\u0275element"](332,"br"),r["\u0275\u0275text"](333,"Example: A request called \u201cRequest an access token\u201d is created in the Sandbox collection. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](334,"p"),r["\u0275\u0275text"](335," 2. In the Authorization tab, click on the Type dropdown and select OAuth 2.0. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](336,"p"),r["\u0275\u0275element"](337,"img",13),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](338,"p"),r["\u0275\u0275text"](339," 3. The pane to the right of that will allow you to Configure New Token. Select and fill in the fields as follows: "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](340,"ol"),r["\u0275\u0275elementStart"](341,"li"),r["\u0275\u0275elementStart"](342,"p"),r["\u0275\u0275text"](343," Token name - Provide a name to identify this token. e.g., Sandbox access token "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](344,"li"),r["\u0275\u0275elementStart"](345,"p"),r["\u0275\u0275text"](346," Grant type - Select the grant type based on the information that Absa has provided. If you have been provided with a \u201cClient ID\u201d and Client secret, then you must select Authorization Code. If you have not been provided with a Client secret, which is the case in this example, you must select Authorization Code (With PKCE). Refer to the next section for more information. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](347,"li"),r["\u0275\u0275elementStart"](348,"p"),r["\u0275\u0275text"](349," Callback URL \u2013 Postman will prepopulate the callback URL with the global shortened URL for Postman. You do not need to change this. Just tick the \u201cAuthorize Using Browser\u201d option. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](350,"p"),r["\u0275\u0275element"](351,"img",14),r["\u0275\u0275element"](352,"br"),r["\u0275\u0275text"](353,"Token Name configuration "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](354,"p"),r["\u0275\u0275text"](355," d. Auth URL \u2013 Provide the authorisation URL that Absa provided e.g. "),r["\u0275\u0275elementStart"](356,"a",15),r["\u0275\u0275text"](357,"https://absaauthuat.absabank.co.ke/auth/realms/sandbox/protocol/OpenID-connect/auth"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](358,"p"),r["\u0275\u0275text"](359," e. Access token URL \u2013 Provide the Token URL that Absa provided e.g. "),r["\u0275\u0275elementStart"](360,"a",10),r["\u0275\u0275text"](361,"https://absaauthuat.absabank.co.ke/auth/realms/sandbox/protocol/OpenID-connect/token"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](362,"p"),r["\u0275\u0275text"](363," f. \u201cClient ID\u201d \u2013 Provide the \u201cClient ID\u201d that Absa provided e.g., sandboxclient "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](364,"p"),r["\u0275\u0275element"](365,"img",16),r["\u0275\u0275element"](366,"br"),r["\u0275\u0275text"](367,"URLs and \u201cClient ID\u201d configuration "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](368,"p"),r["\u0275\u0275text"](369," g. \u201cClient Secret\u201d - If you have been provided with a \u201cClient Secret\u201d for your client, insert it here. In most cases, you will not be provided with a Client secret, so you can leave this field blank. h. Code Challenge Method - Select the Code Challenge Method from the drop-down list, i.e., SHA-256 "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](370,"p"),r["\u0275\u0275element"](371,"img",17),r["\u0275\u0275element"](372,"br"),r["\u0275\u0275text"](373,"Code Challenge Method configuration "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](374,"p"),r["\u0275\u0275text"](375,"i. Scope - Only provide this one scope i.e., OpenID"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](376,"p"),r["\u0275\u0275text"](377," j. State - This parameter must contain a valid consent ID. This consent ID must be obtained from one of the consent request APIs. The consent ID will be unique to each request and will only be valid for a single use, e.g., 4568947589687 "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](378,"p"),r["\u0275\u0275element"](379,"img",18),r["\u0275\u0275element"](380,"br"),r["\u0275\u0275text"](381,"Scope and State configuration "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](382,"p"),r["\u0275\u0275text"](383," 4. Once all the fields are correctly populated, you can request an access token using the Get New Access Token button. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](384,"p"),r["\u0275\u0275text"](385," 5. A new browser window will be opened, and you will be presented with the Absa authorisation login screen. Enter the username and password for the digital account that has been provided for your testing. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](386,"p"),r["\u0275\u0275element"](387,"img",19),r["\u0275\u0275element"](388,"br"),r["\u0275\u0275text"](389,"Enter username and password "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](390,"p"),r["\u0275\u0275text"](391," The details of the consent are provided to you. This example is a payment request therefore payment details are displayed. Click the Accept button to authorise the request and provide consent for it. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](392,"p"),r["\u0275\u0275element"](393,"img",3),r["\u0275\u0275element"](394,"br"),r["\u0275\u0275text"](395,"Click Accept to authorise the payment "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](396,"p"),r["\u0275\u0275text"](397," The Absa authorisation screen will close, and you will be directed back to Postman. A pop-up in Postman will contain the access token which you will need to store for subsequent requests where the token is required in the Header called \u201cX-Absa-Client-Auth\u201d. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](398,"blockquote"),r["\u0275\u0275elementStart"](399,"p"),r["\u0275\u0275elementStart"](400,"strong"),r["\u0275\u0275text"](401,"The digital account credentials (username and password) that you use here must be the owner of the account for whom your consent ID was provided."),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](402,"p"),r["\u0275\u0275elementStart"](403,"strong"),r["\u0275\u0275text"](404,"In the case of a Payment Initiation Consent, the credentials must be the owner of the debit account that was provided in the payment consent request. In the case of an Account Information Consent, the credentials must be the owner of the account provided in the account information consent request."),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](405,"h3"),r["\u0275\u0275text"](406,"Authorization Code with PKCE"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](407,"p"),r["\u0275\u0275text"](408," It\u2019s important to note that when using client-side applications there is no secure way to store client credentials in a client-side application. For most cases, Absa will create the client on Absa SSO as a \u201cPublic\u201d access client. Public clients are not required to provide client secrets. Public clients are secure when HTTPS is strictly enforced and redirect URIs registered for the client are strictly controlled. HTML5/JavaScript clients have to be public clients because there is no way to securely transmit the \u201cClient Secret\u201d to HTML5/JavaScript clients. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](409,"p"),r["\u0275\u0275text"](410," Additionally, Absa SSO will require that the Authorization Code flow is used with "),r["\u0275\u0275elementStart"](411,"a",6),r["\u0275\u0275text"](412,"Proof Key for Code Exchange"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275text"](413," (PKCE). Absa SSO will require that the client use the SHA256-based PKCE method. To enable the use of this method with the JavaScript client adapter, the following option is passed in the init() method: "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](414,"blockquote"),r["\u0275\u0275elementStart"](415,"p"),r["\u0275\u0275elementStart"](416,"strong"),r["\u0275\u0275text"](417,'pkceMethod - The method for Proof Key Code Exchange (PKCE) to use. Configuring this value enables the PKCE mechanism. Available options: == "S256" - The SHA256 based PKCE method'),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](418,"p"),r["\u0275\u0275text"](419," Refer to the Keycloak documents for more information: "),r["\u0275\u0275elementStart"](420,"a",20),r["\u0275\u0275text"](421,"Securing Applications and Services Guide"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"]())},styles:['@charset "UTF-8";@media (max-width:576px){[_nghost-%COMP%]     .page-content{padding:5px 5px 40px}}[_nghost-%COMP%]     img{max-width:100%;max-height:100%;display:block}[_nghost-%COMP%]     .screen1 img{width:100%;height:100%;max-width:620px;max-height:540px;display:block}[_nghost-%COMP%]     .screen2 img{width:100%;height:100%;max-width:670px;max-height:300px;display:block}[_nghost-%COMP%]     blockquote{font-weight:400;line-height:1.5;color:var(--body-color);text-align:left;box-sizing:border-box;background:var(--disabled-background);border-left:10px solid #ccc;margin:1.5em 10px;padding:1em 10px .1em;quotes:"\u201c" "\u201d" "\u2018" "\u2019"}[_nghost-%COMP%]     table{background:#f8f8f8;margin:20px 0}[_nghost-%COMP%]     table thead th{background:#f8f8f8;color:#2d2323;font-weight:600;padding:5px 10px;font-size:16px;border:1px solid #ddd}[_nghost-%COMP%]     table td{text-align:left;padding:5px 10px;border:1p