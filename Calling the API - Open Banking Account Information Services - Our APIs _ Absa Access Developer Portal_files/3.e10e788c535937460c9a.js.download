          }\n            catch (Exception ex)\n            {\n                Console.WriteLine($"ERROR: {ex}");\n            }\n        }\n    }\n}',this.codeScenario1DotNetFullSnippet='// AVS API Sample for C#.\nusing System;\nnamespace AVSAPI\n{\n    class Hello\n    {\n        static async Task Main(string[] args)\n        {\n            Console.WriteLine("This is the AVS API banks lookup request");\n\n            var handler = new HttpClientHandler\n            {\n                ClientCertificateOptions = ClientCertificateOption.Manual,\n                SslProtocols = SslProtocols.Tls12\n            };\n\n            var cert = new X509Certificate2(@"[file path of client certificate issued by Absa Developer Portal]", "[certificate password]");\n            handler.ClientCertificates.Add(cert);\n\n            var apiClient = new HttpClient(handler);\n            apiClient.SetBearerToken("[access token]");\n            apiClient.DefaultRequestHeaders.Add("X-Absa-Initiating-Userid", "[id of the user/system initiating the request]");\n            apiClient.DefaultRequestHeaders.Add("X-Absa-ClientInteractionId", "[value used as correlation id]");\n            apiClient.DefaultRequestHeaders.Add("X-Absa-Nonce", "[unique one time value used for replay protection]");\n\n            try\n            {\n                Console.WriteLine($"- Submitting banks lookup request to the AVS service ...");\n\n                var response = await apiClient.GetAsync("[avs api url]" + "/accounts/verifications/banks");\n\n                response.EnsureSuccessStatusCode();\n\n                var content = await response.Content.ReadAsStringAsync();\n\n                dynamic parsedJson = JsonConvert.DeserializeObject(content);\n                var formattedJson = JsonConvert.SerializeObject(parsedJson, Formatting.Indented);\n                Console.WriteLine(formattedJson);\n\n                Console.WriteLine("AVS API banks lookup request successful");\n            }\n            catch (Exception ex)\n            {\n                Console.WriteLine($"ERROR: {ex}");\n            }\n        }\n    }\n}',this.codeScenario1JavaSnippet='public class AVSAPI {\n\n    public static void main(String[] args) {\n        // Prints "This is the AVS API."\n        System.out.println("This is the AVS API");\n    }\n\n}',this.codeScenario2DotNetCoreSnippet='// AVS API Sample for C#.\nusing System;\nnamespace AVSAPI\n{\n    class Hello\n    {\n        static async Task Main(string[] args)\n        {\n            Console.WriteLine("This is the AVS API account verification request");\n\n            var handler = new HttpClientHandler\n            {\n                ClientCertificateOptions = ClientCertificateOption.Manual,\n                SslProtocols = SslProtocols.Tls12\n            };\n\n            var cert = new X509Certificate2(@"[file path of client certificate issued by Absa Developer Portal]", "[certificate password]");\n            handler.ClientCertificates.Add(cert);\n\n            var apiClient = new HttpClient(handler);\n            apiClient.SetBearerToken("[access token]");\n            apiClient.DefaultRequestHeaders.Add("X-Absa-Initiating-Userid", "[id of the user/system initiating the request]");\n            apiClient.DefaultRequestHeaders.Add("X-Absa-ClientInteractionId", "[value used as correlation id]");\n            apiClient.DefaultRequestHeaders.Add("X-Absa-Nonce", "[unique one time value used for replay protection]");\n\n            var batchRequest = new\n            {\n                ClientReference = $"{Guid.NewGuid()}",\n                Servicer = new\n                {\n                    SchemeName = "BICFI",\n                    Identification = "FIRNZAJJ"\n                },\n                Account = new\n                {\n                    SchemeName = "BranchCodeAccountNumber",\n                    Identification = "123456999999923",\n                    AccountSubType = "Transmission"\n                },\n                Client = new\n                {\n                    SchemeName = "Passport",\n                    Identification = "12345KEMPTON",\n                    Name = "Superman",\n                    Initials = "CK"\n                }\n            };\n\n            var requests = new List<object>\n            {\n                batchRequest\n            };\n            var accVerBatchReq = new\n            {\n                Data = requests\n            };\n\n            var httpContent = new StringContent(JsonConvert.SerializeObject(accVerBatchReq), Encoding.UTF8, "application/json");\n\n            try\n            {\n                Console.WriteLine("- Submitting account verification request to the AVS service ...");\n\n                var response = await apiClient.PostAsync("[avs api url]" + "/accounts/verifications", httpContent);\n\n                response.EnsureSuccessStatusCode();\n\n                var content = await response.Content.ReadAsStringAsync();\n\n                dynamic parsedJson = JsonConvert.DeserializeObject(content);\n                var formattedJson = JsonConvert.SerializeObject(parsedJson, Formatting.Indented);\n                Console.WriteLine(formattedJson);\n\n                dynamic avsResult = JObject.Parse(content);\n\n                var batchId = avsResult.Data.BatchId;\n                Console.WriteLine($"AVS API account verification - batch id returned is {batchId}");\n\n                Console.WriteLine("AVS API account verification request successful");\n            }\n            catch (Exception ex)\n            {\n                Console.WriteLine($"ERROR: {ex}");\n            }\n        }\n    }\n}',this.codeScenario2DotNetFullSnippet='// AVS API Sample for C#.\nusing System;\nnamespace AVSAPI\n{\n    class Hello\n    {\n        static async Task Main(string[] args)\n        {\n            Console.WriteLine("This is the AVS API account verification request");\n\n            var handler = new HttpClientHandler\n            {\n                ClientCertificateOptions = ClientCertificateOption.Manual,\n                SslProtocols = SslProtocols.Tls12\n            };\n\n            var cert = new X509Certificate2(@"[file path of client certificate issued by Absa Developer Portal]", "[certificate password]");\n            handler.ClientCertificates.Add(cert);\n\n            var apiClient = new HttpClient(handler);\n            apiClient.SetBearerToken("[access token]");\n            apiClient.DefaultRequestHeaders.Add("X-Absa-Initiating-Userid", "[id of the user/system initiating the request]");\n            apiClient.DefaultRequestHeaders.Add("X-Absa-ClientInteractionId", "[value used as correlation id]");\n            apiClient.DefaultRequestHeaders.Add("X-Absa-Nonce", "[unique one time value used for replay protection]");\n\n            var batchRequest = new\n            {\n                ClientReference = $"{Guid.NewGuid()}",\n                Servicer = new\n                {\n                    SchemeName = "BICFI",\n                    Identification = "FIRNZAJJ"\n                },\n                Account = new\n                {\n                    SchemeName = "BranchCodeAccountNumber",\n                    Identification = "123456999999923",\n                    AccountSubType = "Transmission"\n                },\n                Client = new\n                {\n                    SchemeName = "Passport",\n                    Identification = "12345KEMPTON",\n                    Name = "Superman",\n                    Initials = "CK"\n                }\n            };\n\n            var requests = new List<object>\n            {\n                batchRequest\n            };\n            var accVerBatchReq = new\n            {\n                Data = requests\n            };\n\n            var httpContent = new StringContent(JsonConvert.SerializeObject(accVerBatchReq), Encoding.UTF8, "application/json");\n\n            try\n            {\n                Console.WriteLine("- Submitting account verification request to the AVS service ...");\n\n                var response = await apiClient.PostAsync("[avs api url]" + "/accounts/verifications", httpContent);\n\n                response.EnsureSuccessStatusCode();\n\n                var content = await response.Content.ReadAsStringAsync();\n\n                dynamic parsedJson = JsonConvert.DeserializeObject(content);\n                var formattedJson = JsonConvert.SerializeObject(parsedJson, Formatting.Indented);\n                Console.WriteLine(formattedJson);\n\n                dynamic avsResult = JObject.Parse(content);\n\n                var batchId = avsResult.Data.BatchId;\n                Console.WriteLine($"AVS API account verification - batch id returned is {batchId}");\n\n                Console.WriteLine("AVS API account verification request successful");\n            }\n            catch (Exception ex)\n            {\n                Console.WriteLine($"ERROR: {ex}");\n            }\n        }\n    }\n}',this.codeScenario2JavaSnippet='\npublic class AVSAPI {\n\n    public static void main(String[] args) {\n        // Prints "This is the AVS API."\n        System.out.println("This is the AVS API");\n    }\n\n}',this.codeScenario3DotNetCoreSnippet='// AVS API Sample for C#.\nusing System;\nnamespace AVSAPI\n{\n    class Hello\n    {\n        static async Task Main(string[] args)\n        {\n            Console.WriteLine("This is the AVS API account verification status query request");\n\n            var handler = new HttpClientHandler\n            {\n                ClientCertificateOptions = ClientCertificateOption.Manual,\n                SslProtocols = SslProtocols.Tls12\n            };\n\n            var cert = new X509Certificate2(@"[file path of client certificate issued by Absa Developer Portal]", "[certificate password]");\n            handler.ClientCertificates.Add(cert);\n\n            var apiClient = new HttpClient(handler);\n            apiClient.SetBearerToken("[access token]");\n            apiClient.DefaultRequestHeaders.Add("X-Absa-Initiating-Userid", "[id of the user/system initiating the request]");\n            apiClient.DefaultRequestHeaders.Add("X-Absa-ClientInteractionId", "[value used as correlation id]");\n            apiClient.DefaultRequestHeaders.Add("X-Absa-Nonce", "[unique one time value used for replay protection]");\n\n            try\n            {\n                Console.WriteLine($"- Submitting account verification status query request to the AVS service ...");\n\n                var response = await apiClient.GetAsync("[avs api url]" + "/accounts/verifications/" + "[batchId]");\n\n                response.EnsureSuccessStatusCode();\n\n                var content = await response.Content.ReadAsStringAsync();\n\n                dynamic parsedJson = JsonConvert.DeserializeObject(content);\n                var formattedJson = JsonConvert.SerializeObject(parsedJson, Formatting.Indented);\n                Console.WriteLine(formattedJson);\n\n                var accountVerifications = (IEnumerable)parsedJson.Data.AccountVerifications;\n                Console.WriteLine($"AVS API account verification status query - account verifications returned: {accountVerifications}");\n\n                Console.WriteLine("AVS API account verification status query request successful");\n            }\n            catch (Exception ex)\n            {\n                Console.WriteLine($"ERROR: {ex}");\n            }\n        }\n    }\n}',this.codeScenario3DotNetFullSnippet='// AVS API Sample for C#.\nusing System;\nnamespace AVSAPI\n{\n    class Hello\n    {\n        static async Task Main(string[] args)\n        {\n            Console.WriteLine("This is the AVS API account verification status query request");\n\n            var handler = new HttpClientHandler\n            {\n                ClientCertificateOptions = ClientCertificateOption.Manual,\n                SslProtocols = SslProtocols.Tls12\n            };\n\n