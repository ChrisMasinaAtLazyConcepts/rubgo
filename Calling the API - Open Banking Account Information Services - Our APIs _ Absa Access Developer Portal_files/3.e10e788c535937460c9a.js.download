text"](141,"3.2.1 Retrieve consent status"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](142,"p"),r["\u0275\u0275text"](143,"The TPP can view the status of the consent using consent ID to determine the status of the consent. The consent status will be updated after the consent has been authorised/rejected in Step 3 of the process flow and when the final payment has been submitted in Step 5."),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](144,"p"),r["\u0275\u0275elementStart"](145,"strong"),r["\u0275\u0275elementStart"](146,"em"),r["\u0275\u0275text"](147,"Query By:"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275text"](148," {Consent ID} "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](149,"p"),r["\u0275\u0275elementStart"](150,"em"),r["\u0275\u0275text"](151,"Precondition"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275text"](152,": Consent request was created {Consent ID} "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](153,"p"),r["\u0275\u0275elementStart"](154,"strong"),r["\u0275\u0275elementStart"](155,"em"),r["\u0275\u0275text"](156,"Postcondition"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275text"](157,": Consent status is updated. Status should be \u201cAuthorised\u201d to move to the next request. "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275element"](158,"blockquote"),r["\u0275\u0275elementStart"](159,"p"),r["\u0275\u0275elementStart"](160,"strong"),r["\u0275\u0275elementStart"](161,"em"),r["\u0275\u0275text"](162,"Flow"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275text"](163,": As indicated below "),r["\u0275\u0275elementEnd"](),r["\u0275\u0275element"](164,"img",4),r["\u0275\u0275elementStart"](165,"h2"),r["\u0275\u0275text"](166,"3.3 Funds Confirmation [GET /domestic-payment-consents/{ConsentId}/funds-confirmation]"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](167,"p"),r["\u0275\u0275text"](168,"The API endpoint allows the PISP to ask an ASPSP to confirm funds on a domestic-payment-consents resource."),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](169,"ul"),r["\u0275\u0275elementStart"](170,"li"),r["\u0275\u0275elementStart"](171,"p"),r["\u0275\u0275text"](172,"Absa as the ASPSP can only respond to a funds confirmation request if the domestic-payment-consents resource has an \u2018Authorised\u2019 status. If the status is not \u201cAuthorised\u201d, Absa must respond with a 400 (Bad request) and an error code."),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](173,"li"),r["\u0275\u0275elementStart"](174,"p"),r["\u0275\u0275text"](175,"Confirmations of funds requests do not affect the status of the domestic-payment-consents resource."),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](176,"h3"),r["\u0275\u0275text"](177,"3.3.1 Funds confirmation check"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](178,"p"),r["\u0275\u0275text"](179,"The TPP consumes this API to verify that the client has funds available in their account to process the consent for the payment request."),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](180,"p"),r["\u0275\u0275text"](181,"This is an optional call to return an indicator of whether funds are available and checks the available balance, limits and status of the account before proceeding to make the payment. If the funds check returns a \u201cFalse\u201d, a reason will be provided, and the payment request cannot be submitted."),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementStart"](182,"p"),r["\u0275\u0275elementStart"](183,"strong"),r["\u0275\u0275elementStart"](184,"em"),r["\u0275\u0275text"](185,"Precondition"),r["\u0275\u0275elementEnd"](),r["\u0275\u0275elementEnd"](),r["\u0275\u0275text"](186,": Consent Status = \u201cAuthorised\u201d and client authentication token i