content:t.fullContent}})],1)},Ie=[],qe={name:"PCI",components:{HeaderTemplate:ht.A,SectionColumn:ft.A},data(){return{contentHeader:{title:"PCI compliance",text:"<p>Payfast is PCI DSS level 1 compliant. PCI DSS stands for Payment Card Industry Data Security Standard and is a PASA (Payment Association of South Africa) regulation in South Africa, this means any company accepting credit card payments on their website needs to comply in some way. </p>",svg:'<svg width="29" height="29" viewBox="0 0 41 41" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="20.5" cy="20.5" r="20.5" fill="#E12E56"/><g clip-path="url(#clip0_4530_42535)"><path d="M22.2812 11.8906H16.9375C16.6096 11.8906 16.3438 12.1565 16.3438 12.4844V13.6719C16.3438 13.9998 16.6096 14.2656 16.9375 14.2656H22.2812C22.6092 14.2656 22.875 13.9998 22.875 13.6719V12.4844C22.875 12.1565 22.6092 11.8906 22.2812 11.8906Z" fill="white"/><path d="M25.25 16.9375C24.7432 16.9375 24.2413 17.0373 23.7731 17.2312C23.3048 17.4252 22.8794 17.7095 22.521 18.0679C22.1626 18.4262 21.8783 18.8517 21.6844 19.3199C21.4904 19.7882 21.3906 20.2901 21.3906 20.7969C21.598 25.9186 28.909 25.9111 29.1094 20.7968C29.1083 19.7736 28.7013 18.7926 27.9778 18.0691C27.2542 17.3456 26.2732 16.9386 25.25 16.9375ZM27.0045 20.4733L25.2233 22.2545C25.1685 22.3099 25.1034 22.3539 25.0315 22.3839C24.9597 22.4139 24.8826 22.4294 24.8047 22.4294C24.7268 22.4294 24.6497 22.4139 24.5779 22.3839C24.506 22.3539 24.4408 22.3099 24.3861 22.2545L23.4955 21.3639C23.3869 21.2524 23.3265 21.1026 23.3275 20.9469C23.3285 20.7912 23.3908 20.6422 23.5009 20.5322C23.611 20.4221 23.76 20.3598 23.9157 20.3588C24.0713 20.3577 24.2211 20.4181 24.3327 20.5267L24.8047 20.9958L26.1673 19.6361C26.2788 19.5271 26.4287 19.4664 26.5846 19.4673C26.7405 19.4681 26.8898 19.5304 27 19.6406C27.1102 19.7509 27.1725 19.9001 27.1734 20.056C27.1742 20.2119 27.1136 20.3619 27.0045 20.4733Z" fill="white"/><path d="M12.4844 29.1094H26.7344C26.8917 29.1089 27.0425 29.0462 27.1537 28.935C27.265 28.8237 27.3277 28.673 27.3281 28.5156V24.3908C24.6415 26.0127 21.0505 23.9471 21.0938 20.7968C21.0348 17.6591 24.6535 15.5755 27.3281 17.2016V13.6719C27.3277 13.5145 27.265 13.3638 27.1537 13.2525C27.0425 13.1413 26.8917 13.0786 26.7344 13.0781H23.1719V13.6719C23.1716 13.908 23.0777 14.1344 22.9107 14.3014C22.7438 14.4683 22.5174 14.5622 22.2812 14.5625H16.9375C16.7014 14.5622 16.475 14.4683 16.308 14.3014C16.141 14.1344 16.0471 13.908 16.0469 13.6719V13.0781H12.4844C12.327 13.0786 12.1763 13.1413 12.065 13.2525C11.9538 13.3638 11.8911 13.5145 11.8906 13.6719V28.5156C11.8911 28.673 11.9538 28.8237 12.065 28.935C12.1763 29.0462 12.327 29.1089 12.4844 29.1094ZM13.6719 17.8281C13.6723 17.6708 13.735 17.52 13.8463 17.4088C13.9575 17.2975 14.1083 17.2348 14.2656 17.2344H19.0156C19.173 17.2348 19.3237 17.2975 19.435 17.4088C19.5462 17.52 19.6089 17.6708 19.6094 17.8281V18.125C19.6089 18.2823 19.5462 18.4331 19.435 18.5443C19.3237 18.6556 19.173 18.7183 19.0156 18.7188H14.2656C14.1083 18.7183 13.9575 18.6556 13.8463 18.5443C13.735 18.4331 13.6723 18.2823 13.6719 18.125V17.8281ZM13.6719 20.7969C13.6723 20.6395 13.735 20.4888 13.8463 20.3775C13.9575 20.2663 14.1083 20.2036 14.2656 20.2031H19.0156C19.173 20.2036 19.3237 20.2663 19.435 20.3775C19.5462 20.4888 19.6089 20.6395 19.6094 20.7969V21.0938C19.6089 21.2511 19.5462 21.4018 19.435 21.5131C19.3237 21.6243 19.173 21.687 19.0156 21.6875H14.2656C14.1083 21.687 13.9575 21.6243 13.8463 21.5131C13.735 21.4018 13.6723 21.2511 13.6719 21.0938V20.7969ZM13.6719 23.7656C13.6723 23.6083 13.735 23.4575 13.8463 23.3463C13.9575 23.235 14.1083 23.1723 14.2656 23.1719H19.0156C19.173 23.1723 19.3237 23.235 19.435 23.3463C19.5462 23.4575 19.6089 23.6083 19.6094 23.7656V24.0625C19.6089 24.2198 19.5462 24.3706 19.435 24.4818C19.3237 24.5931 19.173 24.6558 19.0156 24.6562H14.2656C14.1083 24.6558 13.9575 24.5931 13.8463 24.4818C13.735 24.3706 13.6723 24.2198 13.6719 24.0625V23.7656Z" fill="white"/></g><defs><clipPath id="clip0_4530_42535"><rect width="19" height="19" fill="white" transform="translate(11 11)"/></clipPath></defs></svg>'},fullContent:[{doc_section_content_id:63,template:"standard",data:{text:'Outsourcing your card payments to Payfast means you do not have to be concerned about the laborious process of\n                            being PCI compliant, and can rest assured in the knowledge that card information is handled securely. <br / ><br / >\n                            For more information on PCI compliance you can refer our <a href="https://payfast.io/blog/pci-compliance/" class="link--text" target="_blank" rel="noreferrer">blog post</a>, or to the\n                            <a href="https://www.pcisecuritystandards.org/pdfs/best_practices_securing_ecommerce.pdf" class="link--text" target="_blank" rel="noreferrer">PCI security standards best practices</a>.\n                            You can, if need be, take the <a href="https://www.pcisecuritystandards.org/documents/SAQ_A_v3.pdf" class="link--text" target="_blank" rel="noreferrer">PCI self assessment questionaire</a>.'}}]}}},Ee=qe,De=(0,L.A)(Ee,$e,Ie,!1,null,"3fd7af8b",null),Oe=De.exports,Ve=function(){var t=this,e=t._self._c;return e(p.A,{staticClass:"docScroll",attrs:{id:"ports-ips"}},[e("HeaderTemplate",{attrs:{data:t.contentHeader}}),e("SectionColumn",{attrs:{type:"full",title:"Ports",content:t.ports}}),e("SectionColumn",{attrs:{type:"left",title:"IP addresses",badge:"Updated",content:t.ipLeftCol}}),e("SectionColumn",{attrs:{type:"right",content:t.ipRightCol}})],1)},Ue=[],Me={name:"Ports_Ip",components:{SectionColumn:ft.A,HeaderTemplate:ht.A},data(){return{contentHeader:{title:"Ports and IP addresses",text:"<p>The following information can be used by system administrators if any changes need to be made to your servers when integrating with Payfast.</p>",svg:'<svg width="29" height="29" viewBox="0 0 41 41" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="20.5" cy="20.5" r="20.5" fill="#E12E56"/><g clip-pat